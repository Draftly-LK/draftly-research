# Private client/legal document bundles
data/raw/

# Private discussion recordings, transcripts, and service-account keys.
# Both the old top-level path and the current proj-docs/ path are listed: the
# folder moved and the stale rules left a GCP key unignored.
discussions/recordings/*
discussions/transcripts/*
discussions/secrets/*
proj-docs/discussions/recordings/*
proj-docs/discussions/transcripts/*
proj-docs/discussions/secrets/*

# Credentials, wherever they land
*.pem
*-service-account*.json
draftly-*-*.json

# Generated LaTeX build files
report/*.aux
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
/.agents
AGENTS.md
.agents/skills/README.md
/.agents
