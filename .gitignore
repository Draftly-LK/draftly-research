.env

# Scratch / temp working files
tmp/

# Python environment & caches
.venv/
__pycache__/
*.pyc

# Environment-specific agent skill links installed by `streamlit skills`
.claude/skills/developing-with-streamlit/

# Generated retrieval artifacts (rebuildable from the PDFs)

