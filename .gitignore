.claude/settings.local.json

# Third-party legal-database extracts: raw cached pages and run outputs.
# The derived section index and actions.csv ARE tracked, each row labelled
# with its source; the raw dump is not.
evaluation/runs/lawlanka-section-index/

progress.md

# macOS folder metadata
.DS_Store

# Supreme Court judgment PDFs in data/supremecourt.lk/ are tracked.

# Extracted PDF text cache for the SC rule-extraction pipelines (rebuildable
# from the PDFs via pypdfium2; copyrighted judgment text, kept local).
scripts/case-law-information-extraction/output/supremecourt-lk/text-cache/

# OCR benchmark: real client documents, rendered pages, run outputs and
# annotations stay local. Only code, schemas, and aggregate reports are tracked.
# cases/* rather than cases/ so the README can be re-included: git cannot
# un-exclude a file whose parent directory is itself excluded.
ocr-benchmark/cases/*
!ocr-benchmark/cases/README.md
ocr-benchmark/renders/
ocr-benchmark/runs/
ocr-benchmark/labels/