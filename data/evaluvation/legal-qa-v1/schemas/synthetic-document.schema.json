{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftly.lk/schemas/legal-qa-v1/synthetic-document.schema.json",
  "title": "Structured synthetic benchmark document (synthetic-documents/<document_id>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id", "benchmark_matter_id", "document_type", "synthetic_marker", "template_id", "generator_version",
    "fields", "rendered_text", "expected_extracted_fields", "document_hash", "public_filename", "contains_statute_citation"
  ],
  "properties": {
    "document_id": { "type": "string", "pattern": "^DOC-M[0-9]{3}-[0-9]{3}$" },
    "benchmark_matter_id": { "type": "string", "pattern": "^M[0-9]{3}$" },
    "document_type": { "type": "string" },
    "synthetic_marker": {
      "const": "SYNTHETIC BENCHMARK DOCUMENT - Draftly legal-qa-v1 - not a real instrument; all persons, numbers and places are fictional"
    },
    "template_id": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "field_name", "value", "fact_id"],
        "properties": {
          "field_id": { "type": "string", "pattern": "^FLD-M[0-9]{3}-[0-9]{3}$" },
          "field_name": { "type": "string" },
          "value": {},
          "fact_id": { "type": "string", "pattern": "^FACT-M[0-9]{3}-[0-9]{3}$", "description": "Every value must resolve to one canonical-ledger fact." }
        }
      }
    },
    "rendered_text": { "type": "string", "minLength": 1, "description": "Plain-text rendering. Must contain the synthetic marker verbatim." },
    "expected_extracted_fields": { "type": "object", "additionalProperties": {} },
    "document_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 of rendered_text (UTF-8)." },
    "public_filename": { "type": "string", "pattern": "^(?!.*(gold|relevant|distractor|decisive|indispensable|answer)).+$" },
    "contains_statute_citation": { "type": "boolean", "description": "True only when a real document of this type would naturally cite the enactment." },
    "signature_policy": { "const": "placeholder_only_no_seal_no_signature_image" }
  }
}
