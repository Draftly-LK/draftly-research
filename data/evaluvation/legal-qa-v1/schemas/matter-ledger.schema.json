{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftly.lk/schemas/legal-qa-v1/matter-ledger.schema.json",
  "title": "Canonical matter ledger (matter-ledger.json): the only source of values for generated documents",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_matter_id", "run_id", "produced_by_agent", "source_facts", "parties", "properties", "instruments",
    "events", "relationships", "financial_values", "registrations", "notices", "court_events", "fact_conflicts",
    "synthetic_additions", "questions", "predicates"
  ],
  "properties": {
    "benchmark_matter_id": { "type": "string", "pattern": "^M[0-9]{3}$" },
    "run_id": { "type": "string" },
    "produced_by_agent": { "type": "string" },
    "source_facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
    "parties": { "type": "array", "items": { "$ref": "#/$defs/party" } },
    "properties": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "instruments": { "type": "array", "items": { "$ref": "#/$defs/instrument" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "financial_values": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "registrations": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "notices": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "court_events": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "fact_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_ids", "description", "resolution"],
        "properties": {
          "fact_ids": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fact_id" } },
          "description": { "type": "string" },
          "resolution": { "enum": ["unresolved_requires_legal_review", "preserved_both_in_source"] }
        }
      }
    },
    "synthetic_additions": {
      "type": "array",
      "description": "Every fact whose origin is not past_paper or law_derived, with the safety reasoning.",
      "items": {
        "type": "object",
        "required": ["fact_id", "reason", "could_affect"],
        "properties": {
          "fact_id": { "$ref": "#/$defs/fact_id" },
          "reason": { "type": "string" },
          "could_affect": {
            "type": "array",
            "description": "Must be empty for synthetic_neutral facts.",
            "items": { "enum": ["applicable_law", "temporal_version", "ownership", "priority", "registration", "legal_capacity", "prescription", "notice", "stamp_duty", "execution_validity", "remedy", "jurisdiction"] }
          },
          "legal_review_required": { "type": "boolean" }
        }
      }
    },
    "questions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^M[0-9]{3}-Q[0-9]{2}$" } },
    "predicates": { "type": "array", "items": { "type": "string", "pattern": "^PR-M[0-9]{3}-[0-9]{3}$" } }
  },
  "$defs": {
    "fact_id": { "type": "string", "pattern": "^FACT-M[0-9]{3}-[0-9]{3}$" },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "field", "value", "origin", "source_atomic_ids", "source_quote", "legal_relevance", "supports_predicate_ids", "confidence"],
      "properties": {
        "fact_id": { "$ref": "#/$defs/fact_id" },
        "field": { "type": "string", "minLength": 1, "description": "Dotted ledger path, e.g. parties.PTY01.name" },
        "value": {},
        "value_iso": { "type": ["string", "null"], "description": "ISO form for dates/amounts when value is the source wording." },
        "origin": { "enum": ["past_paper", "law_derived", "synthetic_neutral", "synthetic_decisive"] },
        "source_atomic_ids": { "type": "array", "items": { "type": "string" } },
        "source_quote": { "type": ["string", "null"], "description": "Verbatim past-paper wording the value was read from. Required for past_paper facts." },
        "legal_relevance": { "enum": ["decisive", "supporting", "neutral", "distractor"] },
        "supports_predicate_ids": { "type": "array", "items": { "type": "string", "pattern": "^PR-M[0-9]{3}-[0-9]{3}$" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "past_paper" } } },
          "then": { "properties": { "source_quote": { "type": "string", "minLength": 1 }, "source_atomic_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "origin": { "const": "synthetic_neutral" } } },
          "then": { "properties": { "legal_relevance": { "enum": ["neutral", "distractor", "supporting"] } } }
        }
      ]
    },
    "entity": {
      "type": "object",
      "required": ["id", "fact_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }
      }
    },
    "party": {
      "type": "object",
      "required": ["id", "name", "role", "capacity", "is_real_person", "fact_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^PTY[0-9]{2}$" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "capacity": { "type": "string" },
        "is_real_person": { "const": false, "description": "Ledger parties are fictional exam characters; never a real person." },
        "identity_number_policy": { "const": "none_or_obviously_synthetic" },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }
      }
    },
    "instrument": {
      "type": "object",
      "required": ["id", "instrument_type", "fact_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^INS[0-9]{2}$" },
        "instrument_type": { "type": "string" },
        "number": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "date_iso": { "type": ["string", "null"] },
        "attesting_notary": { "type": ["string", "null"] },
        "parties": { "type": "array", "items": { "type": "string", "pattern": "^PTY[0-9]{2}$" } },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "event_type", "sequence", "fact_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^EVT[0-9]{2}$" },
        "event_type": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "date_iso": { "type": ["string", "null"], "description": "YYYY, YYYY-MM or YYYY-MM-DD as far as the source states." },
        "sequence": { "type": "integer", "minimum": 1, "description": "Chronological order; validators check monotonicity against date_iso." },
        "parties": { "type": "array", "items": { "type": "string", "pattern": "^PTY[0-9]{2}$" } },
        "instrument_id": { "type": ["string", "null"] },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["from_party", "to_party", "relationship", "fact_ids"],
      "properties": {
        "from_party": { "type": "string", "pattern": "^PTY[0-9]{2}$" },
        "to_party": { "type": "string", "pattern": "^PTY[0-9]{2}$" },
        "relationship": { "type": "string" },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }
      }
    }
  }
}
