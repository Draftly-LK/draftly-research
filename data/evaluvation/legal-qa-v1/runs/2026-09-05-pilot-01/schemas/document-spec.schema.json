{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftly.lk/schemas/legal-qa-v1/document-spec.schema.json",
  "title": "Per-matter document bundle specification with particulars (document-specs.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_matter_id", "run_id", "produced_by_agent", "documents"],
  "properties": {
    "benchmark_matter_id": { "type": "string", "pattern": "^M[0-9]{3}$" },
    "run_id": { "type": "string" },
    "produced_by_agent": { "type": "string" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "benchmark_matter_id", "document_type", "document_role", "required_for_question_ids",
        "supports_predicate_ids", "necessity", "inclusion_reason", "issuer_or_executor", "document_date_fact_id",
        "template_source", "generation_status", "synthetic_label_required", "public_filename", "particulars"
      ],
      "properties": {
        "document_id": { "type": "string", "pattern": "^DOC-M[0-9]{3}-[0-9]{3}$" },
        "benchmark_matter_id": { "type": "string", "pattern": "^M[0-9]{3}$" },
        "document_type": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "document_role": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["explicit", "legally_required", "evidentiary", "supporting", "distractor"] }
        },
        "required_for_question_ids": { "type": "array", "items": { "type": "string", "pattern": "^M[0-9]{3}-Q[0-9]{2}$" } },
        "supports_predicate_ids": { "type": "array", "items": { "type": "string", "pattern": "^PR-M[0-9]{3}-[0-9]{3}$" } },
        "necessity": { "enum": ["indispensable", "supporting", "distractor"] },
        "inclusion_reason": { "type": "string", "minLength": 1 },
        "issuer_or_executor": { "type": "string" },
        "document_date_fact_id": { "type": ["string", "null"], "pattern": "^FACT-M[0-9]{3}-[0-9]{3}$" },
        "template_source": { "type": ["string", "null"] },
        "generation_status": { "enum": ["specified", "structured_generated", "rendered", "blocked"] },
        "synthetic_label_required": { "const": true },
        "public_filename": {
          "type": "string",
          "pattern": "^(?!.*(gold|relevant|distractor|decisive|indispensable|answer)).+$",
          "description": "Neutral filename exposed to evaluated systems. Must not leak role."
        },
        "distractor_rationale": { "type": ["string", "null"], "description": "Required for distractors: why it cannot create an alternative correct answer." },
        "particulars": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/particular" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "necessity": { "const": "indispensable" } } },
          "then": { "properties": { "supports_predicate_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "necessity": { "const": "distractor" } } },
          "then": { "required": ["distractor_rationale"], "properties": { "distractor_rationale": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "particular": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id", "field_name", "data_type", "value_source", "required", "legal_relevance",
        "supports_predicate_ids", "validation_rules", "source_origin", "generation_allowed"
      ],
      "properties": {
        "field_id": { "type": "string", "pattern": "^FLD-M[0-9]{3}-[0-9]{3}$" },
        "field_name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "data_type": { "enum": ["string", "date", "integer", "decimal", "money_lkr", "fraction", "boolean", "text_block", "list"] },
        "value_source": {
          "type": "string",
          "minLength": 1,
          "description": "Ledger path (e.g. 'ledger.parties.PTY01.name') or fact id (FACT-Mxxx-nnn). Every field resolves into the canonical ledger."
        },
        "required": { "type": "boolean" },
        "legal_relevance": { "enum": ["decisive", "supporting", "neutral", "distractor"] },
        "supports_predicate_ids": { "type": "array", "items": { "type": "string", "pattern": "^PR-M[0-9]{3}-[0-9]{3}$" } },
        "validation_rules": { "type": "array", "items": { "type": "string" } },
        "source_origin": { "enum": ["past_paper", "law_derived", "synthetic_neutral", "synthetic_decisive", "unknown"] },
        "generation_allowed": { "type": "boolean" },
        "decisive_generation_justification": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source_origin": { "const": "synthetic_decisive" } } },
          "then": { "required": ["decisive_generation_justification"], "properties": { "decisive_generation_justification": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "source_origin": { "const": "unknown" } } },
          "then": { "properties": { "generation_allowed": { "const": false } } }
        }
      ]
    }
  }
}
