{
  "globs": [
    "*.md",
    "data/legal-sources/**/*.md",
    "data/raw/**/manifest.md",
    "ocr-benchmark/**/*.md",
    "!contxt.md",
    "!Proposed Curriculum Conveyancing Course.md",
    "!.agents/**"
  ],
  "config": {
    "MD013": false,
    // Repeated subheadings are fine under different parents -- each person's
    // section in progress.md carries its own "Challenges" heading.
    "MD024": { "siblings_only": true }
  }
}
