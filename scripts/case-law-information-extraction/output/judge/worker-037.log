+{"rule_id":"draftly-rule-commonlii-LKSC-2001-4-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports the disciplinary finding against the second respondent, but the statement drops the material distinction that the first respondent was cleared."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-4-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that criminally charactered professional misconduct may justify disenrolment even without a criminal conviction."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-9-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court decided the narrower pleading and prescription points, not a general rule that causes of action must be formulated in terms of relevant statutes."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-40-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court treated this certificate under the Recovery of Loans by Banks Act as conclusive, not every certificate of sale issued under any statute."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-40-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote records how one preliminary issue should have been answered on the case facts, not a usable legal rule."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-42-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that granting a tenancy declaration and ejectment without a prayer for that relief was in excess of jurisdiction."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-42-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the plaintiff's tenancy claim ended when he voluntarily surrendered possession to the new lessees."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-43-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague to capture the holding that monthly tenancy claims are outside a partition action under sections 5(a) and 48(1)."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-43-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a monthly tenant's claim is outside the scope of a partition action and should be considered, if at all, at execution."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-46-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court upheld this will because testamentary intention appeared from the instrument, not because any mix of testamentary forms is generally valid."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-46-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the principle that testamentary intention is gathered from the will's terms and surrounding circumstances."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2002-7-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding depended on a vesting order having been made before the applicant tenant died, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2003-2-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court stated specific categories of temple property and temple legal capacity, while the statement reduces that holding to an imprecise generality."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2003-20-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The ownership-evidence holding is supported, but the cited Land Settlement Ordinance section was not the provision construed for this rule."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2004-10-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court upheld a specific Rule 14(1)(a) objection, not the broad proposition that any preliminary objection may be raised for breach of any rule."}
