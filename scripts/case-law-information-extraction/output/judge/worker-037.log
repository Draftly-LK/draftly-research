+{"rule_id":"draftly-rule-commonlii-LKSC-2001-31-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the notarial deed of gift could not be varied by oral evidence and that no notarial surrender of the appellant's rights existed."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-31-3","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court made this factual finding on the evidence, but it is not a ratio-level legal rule."}
