"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$env:PYTHONIOENCODING='"'utf-8'; @'
import json, pathlib, collections
pack_path=pathlib.Path('scripts/case-law-information-extraction/output/judge/pack-045.json')
out_path=pathlib.Path('scripts/case-law-information-extraction/output/judge/part-045.jsonl')
pack=json.loads(pack_path.read_text(encoding='utf-8'))
ids=[r['rule_id'] for r in pack]
rows=[]
for n,line in enumerate(out_path.read_text(encoding='utf-8').splitlines(),1):
    obj=json.loads(line)
    rows.append(obj)
    required=['rule_id','statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable','reason']
    assert list(obj.keys())==required, (n, list(obj.keys()))
    for k in required[1:6]+['usable']:
        assert isinstance(obj[k], bool), (n,k,type(obj[k]))
    assert isinstance(obj['reason'], str) and obj['reason'].strip(), n
out_ids=[r['rule_id'] for r in rows]
print('pack',len(ids),'rows',len(rows),'unique_out',len(set(out_ids)),'usable',sum(1 for r in rows if r['usable']))
print('missing', sorted(set(ids)-set(out_ids)))
print('extra', sorted(set(out_ids)-set(ids)))
print('dupes', [x for x,c in collections.Counter(out_ids).items() if c>1])
'@ | python -" in D:\projects\draftly
