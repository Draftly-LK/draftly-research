+{"rule_id":"draftly-rule-commonlii-LKCA-1993-33-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court construed Regulation 8 as giving the Corporation a discretion to issue a gemming licence on satisfaction of consent from owners of more than two-thirds of co-owned land."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-24-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that a partition scheme must provide access to a public right of way from within the corpus rather than by imposing access over outside land."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-37-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material requirement that the parties must agree on the premises, tenancy period, and rent payable."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-37-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court treated proof of rent payment, especially rent receipts, as the best test for establishing tenancy in the delivery-of-possession dispute."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-37-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague and omits the two determinations required under Partition Law sections 52(2), 48(1), and Rent Act section 14(1)."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-38-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was about a Rent Act six-month notice for a monthly tenancy in a leap year, not an unqualified rule about every notice to vacate."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-38-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that the Rent Act notice was bad in law because the statutory six-month notice requirement was not complied with."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1994-38-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that non-compliance with the statutory six-month written notice prejudiced the tenant by depriving him of a statutory right."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-13-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The bill-of-lading date was a factual step in assessing the amended credit condition, not a legal rule decided by the Court."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-13-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the decisive facts that the letter-of-credit condition was added after shipment and was impossible for the supplier to fulfil."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-13-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court applied the injunction principle that where the alleged loss is quantified in damages, the balance of convenience generally weighs against injunctive relief."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-17-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement overgeneralizes a partition-sale purchaser's obligation to deposit sale proceeds for the beneficiary into a rule about any party."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-17-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The extracted quote is truncated and the statement omits that section 47 was inapplicable only because the case did not involve several-party distribution claims."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-2-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that the Civil Procedure Code joinder provisions are procedural, not substantive, and should be applied with a common-sense approach."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-2-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote is truncated and the statement omits that section 18 permits striking out an improperly joined party on application before the hearing."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-31-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that an action instituted against a deceased sole defendant is coram non judice and the resulting judgment is void."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-31-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that a person affected by void proceedings may seek to set them aside ex debito justitiae under the court's inherent jurisdiction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-31-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that an urban-tenement tenancy depends on the continued existence of the building and cannot subsist over bare land after demolition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1995-36-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court applied the principle that a monthly tenant's protected rights are not extinguished merely by a partition decree under section 48."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-12-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court construed section 121(2) as requiring witness and document lists to be filed fifteen days before the trial date after notice to the opposite party."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-12-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material circumstances of late filing, no explanation, prejudice to the plaintiff, and the plaintiff having already closed his case."}

