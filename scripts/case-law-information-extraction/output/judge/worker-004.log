+{"rule_id":"draftly-rule-commonlii-LKCA-1984-28-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted the s.71 framework under which the Bank first had to consider whether the land was within its acquisition authority."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-28-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports the s.71(2) restriction issue, but the statement is vague and drops the Finance Act acquisition context."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-3-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The statement reflects a factual finding on the evidence rather than a legal ratio suitable as a case rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-3-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held this mortgage decree and sale were not nullities, but the statement omits the section 15 Mortgage Act and competent-court/default context."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-31-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held receivable rent ran from the Rent Act commencement date, not from an agreed date."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-31-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held the deposit-in-court relief was not available, so the statement reverses the holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-31-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The substance is supported, but the statement's reference to section (c) of the Rent Act is materially defective."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-38-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that transferees taking only undivided shares could not rely on the predecessor's alleged prescription to a specific lot."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-39-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court decided that this particular elucidating amendment did not alter the action, not that plaint amendments generally do not do so."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-15-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The succession rule based on the original dedication was expressly adopted as part of the holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-15-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material qualification that the bequest was in common with succession in turn by seniority."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-15-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote states a definite rule for exempt temples, while the statement incorrectly says the applicable rule is unspecified."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-22-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The abandonment and new tenancy finding is supported, but CPC s.328 was not the provision construed for that standalone tenancy proposition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-22-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The co-owner leasing rule is supported, but it is not a construction of CPC s.328 as claimed in the statute field."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-22-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The appellate procedural point is supported, but it is not a rule construing CPC s.328."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-33-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly construed the Conciliation Boards timing point and used it to hold the tort claim was not prescribed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-34-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the condition that the original and duplicate deed were unavailable, making secondary evidence admissible."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-34-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The Day Book point is supported but depends on missing registry materials and use as secondary proof of the lost folio and registration."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-34-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held the gift deed prevailed by both priority of execution and priority of registration, not execution alone."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-35-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly held that principal-agent issues were governed by corresponding English law under section 3 of the Civil Law Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-35-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The authority finding is supported, but the statement omits that it turned on the contract, evidence, and customary course of this business."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-35-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court found these defendants had pledge authority in the proved Factors Act and business context, not that every such agent in possession has that authority."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-43-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held Harry Halangoda's beneficial interest was limited to life income and not dominium over the trust capital."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-55-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"Section 10 permitted disposal within twelve months unless a tenant applied, and the ratio concerned whether an agreement to sell was a disposal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1985-57-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The presumption was central, but the statement omits the condition that the original will was in the testator's possession and not forthcoming at death."}

