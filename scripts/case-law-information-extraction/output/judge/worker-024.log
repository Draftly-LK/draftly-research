index 0000000000000000000000000000000000000000..15742854cfbf08b6f183d53a0dcc0612a2cc85b8
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-024.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-67-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The judgment expressly held that a tenant must use and preserve the leased premises with the diligence of an owner."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-67-3","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted passage supports the factual finding of deterioration on a balance of probability, but the statement overstates that fact-specific result as a general claim-establishment rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-68-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The rule is the court's holding on section 35 of the Ceylon Petroleum Corporation Act, but the claimed statute section points to an unrelated partition-law provision."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-69-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on the settled rule that a party may not make at trial a materially different case from the one placed on record."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-69-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court required proof of adverse possession and uninterrupted independent user for at least ten years, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-71-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated the ability to bring another partition action after dismissal as material to why amendment caused no meaningful prejudice."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-71-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court made a case-specific no-prejudice finding about adding a Thesawalamai spouse in a partition action, not a general rule that plaint amendments cause no prejudice."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-98-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the co-owner ouster principle and held that convenient occupation of a defined portion, even for decades, did not prove adverse possession."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-99-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the petitioner's mere occupation as a trespasser, without a legal document or transfer, gave him no right to occupy the land."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-99-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The judgment held that the lease between the estate entities gave this petitioner no legal basis to occupy because no lease or transfer was made to him."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2003-99-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated the decisive criterion under the State Lands recovery statute as whether the property was State land, which the parties conceded."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-15-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The proposition is correct only in the summary-procedure context under section 705(2), which the statement does not state."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-15-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that where the action appears statute-barred, the defendant should be allowed to appear and defend without furnishing security."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-15-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was that an unjust-enrichment claim was not a liquid claim arising on the two cheques for summary procedure, not that every unjust-enrichment claim is never liquid."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-17-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the power-of-attorney holder's affidavit defective because it lacked the section 183A averments that the party was abroad or unable to swear it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-17-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment required the declarant or recognized agent to state personal knowledge, while the extracted statement wrongly phrases the requirement as one imposed on the party."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-17-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court upheld the objection that a power-of-attorney holder cannot act for a principal who also resides within the court's jurisdiction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-21-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that delivery of possession requires the Fiscal to go to the property described in the writ."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-21-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The rule applies to a section 325 inquiry with a clear conflict about the land visited by the Fiscal, a material condition omitted by the statement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-21-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court placed the initial burden on the plaintiff because the Fiscal's report did not prima facie identify the writ land, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-26-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is incoherent and does not express the actual holding that this Kandyan deed validly renounced the donor's statutory right to revoke."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-26-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court's holding was confined to a Kandyan gift deed with an express section 5(1)(d) renunciation, not any person's generic renunciation of revocation rights."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-26-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court found this deed's reference to section 5(1)(d) showed the donor's intention; it did not lay down a general rule that deeds should clearly express donor intention."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-27-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that conditional transfers are not excluded from the doctrine of laesio enormis."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2004-27-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment discussed a sale in the nature of a spes, not a sale by specimen, so the extracted statement is legally mistranscribed."}

