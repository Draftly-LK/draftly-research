codex
I’ve confirmed all judgment paths exist. Next I’m extracting the immediate source context around each supporting quote, then I’ll inspect the surrounding reasoning and outcomes where the quote alone is not enough.
hook: PreToolUse
hook: PreToolUse Failed
exec
"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -Command '$pack = Get-Content -Raw scripts/case-law-information-extraction/output/judge/pack-050.json | ConvertFrom-Json
foreach ($r in $pack) {
  $text = Get-Content -Raw $r.text_path
  $quote = $r.supporting_quote
  $idx = $text.IndexOf($quote)
  if ($idx -lt 0) {
    $needle = if ($quote.Length -gt 80) { $quote.Substring(0,80) } else { $quote }
    $idx = $text.IndexOf($needle)
  }
  Write-Output "`n===== $($r.rule_id) ====="
  Write-Output "STATEMENT: $($r.statement)"
  Write-Output "STATUTE: $($r.statute_section)"
  Write-Output "FOUND_AT: $idx"
  if ($idx -ge 0) {
    $start = [Math]::Max(0, $idx - 1400)
    $len = [Math]::Min(3000, $text.Length - $start)
    Write-Output ($text.Substring($start, $len) -replace "`r", "")
  } else {
    Write-Output "QUOTE NOT FOUND"
  }
}' in D:\projects\draftly
