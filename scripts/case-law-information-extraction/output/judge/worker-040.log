+{"rule_id":"draftly-rule-courts-coa-CA-PHC-126-20-Judgment-Final.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The court held pending civil proceedings do not bar section 66 proceedings, but the statute field maps to Prevention of Frauds rather than the Primary Courts' Procedure Act."}
+{"rule_id":"draftly-rule-courts-coa-ca-phc-22_2004-1.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court applied the proposition to uphold the Primary Court order, but the supporting quote is expressly from Ananda Sarath Paranagama rather than this judgment's own statement."}
