+{"rule_id":"draftly-rule-courts-coa-CA-RII-0001-23.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The statement is a fact-specific conclusion on a substitution challenge, while the selected quote is only the final dismissal and section 394(2) is not the rule stated."}
+{"rule_id":"draftly-rule-courts-coa-CA-WRIT-337-22-FINAL.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court dismissed writ relief because the dispute was private and fact-heavy, but the supporting quote is from Mendis rather than this court's own holding."}
