+{"rule_id":"draftly-rule-courts-coa-ca-writ.387.17-pdf.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The quote supports one decisive defect, but the rule omits the related urgency and evidentiary conditions and the actual provision construed was section 38 rather than section 2."}

