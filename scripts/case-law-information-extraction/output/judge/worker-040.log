+{"rule_id":"draftly-rule-courts-coa-ca-472-97-16.01.19.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The statement reflects the court's section 3 prescription analysis, but the quote only concerns ouster and the mapped statute is Evidence Ordinance rather than Prescription Ordinance."}
+{"rule_id":"draftly-rule-courts-coa-ca-594-1996-f-22.1.2019.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The acceptance principle was material to the deed-of-gift issue, but the cited statute field points to the later revocation statute rather than the rule on acceptance."}
