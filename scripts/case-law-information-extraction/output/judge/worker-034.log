+{"rule_id":"draftly-rule-commonlii-LKSC-1993-1-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held this will gave only a life interest, but the statement omits the will-specific wording and surrounding circumstances that made that construction reasonable."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1993-1-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held only that the Act did not give absolute title on these facts because no fideicommissum was created, not that the Act never gives absolute title."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1993-1-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly held that the plaintiff-appellants were entitled to claim the property after Podinona Hamine's death."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1993-49-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The proposition is a case-specific factual conclusion about lot 5 and Kendagahalanda, not a prescriptive-title rule under section 3."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1993-49-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The court considered the defendants separately because their title deeds and prescription claims differed, but the statement drops that condition and wrongly tags Prescription Ordinance section 3."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1993-49-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement captures the prescription holding but omits the material requirements of ten years, adverse title independent of co-owners, and the additional circumstances relied on."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-18-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly construed section 416 and held that security for costs is discretionary, judicial, reasoned, and reasonable in amount."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-18-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly held that section 416 security creates a fund to satisfy costs ordered by court if not paid by the plaintiff."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-18-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted holding concerns a section 416 security-for-costs order, while the statement overbroadly refers to making any order."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-20-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"That section 337 was amended by Act No. 53 of 1980 is accurate but is only statutory background, not the operative holding."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-20-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The actual holding was that the original section 337 did not cover decrees for possession of immovable property, which this statement fails to state."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-34-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court made a fact-specific finding that Abeysinghe's title showed no ex facie defect and no contrary evidence, not a general rule that title is valid whenever no defect appears ex facie."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-34-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court faulted the purchasers' notaries for not checking the testamentary position from deeds in their custody, but the statement omits that material factual basis."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-34-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that absence of court permission was not an excuse for the purchasers' failure to tender deeds and price, not that it generally does not nullify a sale agreement."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-40-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is only statutory background and omits the time limits and statutory preconditions that controlled the acquisition power."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-40-2","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The People's Bank power was accepted as statutory background, but the rule omits the conditions precedent and residence bar central to the decision."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1994-40-3","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague and omits the actual conditions the Bank had to satisfy before acquisition."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-1-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that under the Sisyanu Sisya Paramparawa rule the senior pupil succeeds unless the tutor appoints another pupil in preference."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-1-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly held that an oral appointment requires clear and cogent evidence, and found none on the record."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-1-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held the documents showed only de facto management and did not establish de jure Viharadhipathiship, which the statement obscures."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-10-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The court held the appellants failed to establish excess power in leasing vested land, but it did not construe Land Reform Law section 19 for that rule."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-3-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held only that serious prima facie questions justified restoring an enjoining order, not a final finding of unfair competition."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1995-34-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that because the Trust was not a legal entity and no valid release occurred, the petitioners remained public officers."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-14-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"Both the statement and quote are truncated into a vague fragment and do not state the court's procedural holding about concluded Supreme Court matters."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-15-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The section 175 bar was part of the holding, but the statement omits the first proviso allowing unlisted witnesses where special circumstances require it in the interests of justice."}

