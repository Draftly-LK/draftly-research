index 0000000000000000000000000000000000000000..539ee22c3b709cfbe39a7ef458e85d5b64e4baa9
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-018.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-45-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court made a case-specific S.147 discretion ruling, not a general rule that a higher court should not invite a lower court to form a contrary opinion."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-45-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The S.147 holding required a pure question of law capable of disposing of the case without evidence and going to the root of the case, not merely a jurisdiction-affecting issue."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-45-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that S.147 depends on the court's opinion whether the action can be disposed of on issues of law only."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-47-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The proposition is only a vague procedural fact about adding a party and omits the statutory route and status consequences actually decided."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-47-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated the absence of an order substituting the transferee as fatal to his claim to proceed as substituted plaintiff."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-47-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly held that an added party could not assume the status of substituted plaintiff and file a plaint where a plaint was already before court."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-5-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court said condominium registration was not imperative for validity, but also noted non-registration may have other legal consequences."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-5-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The case concerned non-registration of condominium property under the Apartment Ownership Law and did not establish that non-registration of any deed never affects validity."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-5-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court required trial because the validity of Deed 854 raised mixed law and fact issues, which the extracted statement states too generally."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-63-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The substituted plaintiff remained an intestate heir because the Last Will had not been proved, a material condition omitted by the statement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-68-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was tied to deed 2078 creating a divided condominium unit and later ratification, which the broad statement drops."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-68-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted and applied the Roman-Dutch law rule that a minor's invalid contract can be ratified after majority."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-68-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that after ratification on majority the contract binds the former minor as if executed after majority and operates from the original date."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-69-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a donor who reserves a right of revocation may revoke the gift by a later deed without proving reasons in court."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-69-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The validity of reserving a revocation right in a donatio propter nuptias was the sole legal issue and was decided affirmatively."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-7-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The award was set aside because denial of a hearing breached basic principles of natural justice."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-7-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a statutory tribunal deciding rights must observe natural justice even without express statutory provision."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-7-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly rejected the argument that procedural freedom allowed the tribunal to violate natural justice."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-73-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that recovery of the business was distinct from recovery of the building, with occupation and materials only ancillary."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-73-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated equipment, utensils, book debts and goodwill as collectable business assets of the estate."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-73-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that inventory under the Civil Procedure Code follows the grant and performance of administration duties."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-81-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is truncated and omits the necessary reference to proceedings under Rent Act S.22(1)(d)."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-81-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court concerned the tenant's conviction for illegal or immoral use of the premises, not any conviction of the plaintiff."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-81-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The tenancy-ending rule was limited to a conviction by a competent court for immoral or illegal use under Rent Act S.22(1)(d), not any tenant conviction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-83-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted and applied the rule that the propounder bears the burden of proving the will of a free and capable testator."}

