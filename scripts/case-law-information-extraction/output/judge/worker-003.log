+{"rule_id":"draftly-rule-commonlii-LKCA-1983-17-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a residential letting for not less than five years must comply with section 2 of the Prevention of Frauds Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-17-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The no-conviction result depended on the agreement being invalid for want of notarial execution, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-18-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a power of attorney is construed strictly and that this general power did not authorize Workmen's Compensation proceedings."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-18-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court referred specifically to the Commissioner of Workmen's Compensation, not to commissioners generally."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-18-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the nine-year-old executant could not execute a power of attorney."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-24-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that remedies for encroachment may include removal, purchase, or compensation according to the parties' conduct and circumstances."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-7-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court declined interference because of several trade-mark and balance-of-convenience facts, not as a general bar to reviewing ex parte interim injunctions."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1983-8-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote reproduces lower-court reasoning and in any event says the agent was not liable when contracting only as managing agent."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-24-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed Prescription Ordinance section 3 to prevent a party from setting up a stranger's title where that person was neither joined nor a predecessor in title."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1984-28-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the Bank must address three questions under Finance Act section 71 and distinguished reviewable jurisdictional questions from policy discretion."}

