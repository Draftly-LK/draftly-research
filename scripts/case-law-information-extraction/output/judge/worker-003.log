    quote=' '.join(r['supporting_quote'].split())[:160]
    norm=' '.join(text.split())
    idx=norm.find(quote)
    print('\\n===', r['rule_id'], r['citation'])
    print('statement:', r['statement'])
    print('statute:', r['statute_section'] or '(empty)')
    print('quote_found:', idx>=0, 'idx', idx)
    if idx>=0:
        s=max(0,idx-450); e=min(len(norm),idx+len(quote)+1000)
        print(textwrap.fill(norm[s:e], width=120))
