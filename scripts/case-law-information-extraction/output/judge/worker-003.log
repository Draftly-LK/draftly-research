+{"rule_id":"draftly-rule-commonlii-LKCA-1982-22-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that Judicature Act section 47 was confined to prosecutions, so notice to the Attorney-General was unnecessary for the Primary Courts information."}
