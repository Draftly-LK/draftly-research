diff --git a/scripts/case-law-information-extraction/output/judge/part-019.jsonl b/scripts/case-law-information-extraction/output/judge/part-019.jsonl
new file mode 100644
index 0000000000000000000000000000000000000000..0f67b7f0c53e3e676753b0a8a16cb9ce6102bac3
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-019.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-83-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did place the burden for fraud or undue influence on the objectors, but the statement drops the prior will-propounder burden and suspicion-removal context."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-83-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court found no well-grounded suspicion on the evidence, but did not hold that such suspicion is a general prerequisite to challenging a will's authenticity."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-84-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was confined to a Primary Court's duty under section 66 before a possession inquiry, while the statement states it too broadly as a duty of any court."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-84-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports a condition precedent, but only for the Primary Court's section 66(7) inquiry after failed settlement efforts, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-84-3","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is a vague description of one step in the statutory possession inquiry rather than the court's holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-89-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court treated the undisputed survey report as decisive on these facts, not as a general rule that a Commissioner's report determines the corpus."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-89-2","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"This merely repeats a factual comment about the plaintiff's failure to act under section 5 and is not a legal holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-89-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment faulted ignoring a relevant survey report in this partition case, but the statement is an overbroad generalization."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-91-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly held that due execution of the deed was proved on a balance of probability and used that standard to dismiss the appeal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-91-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that non-observance of Notaries Ordinance section 31 rules did not invalidate the deed because section 33 protected it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-91-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court stated as its own view that due execution essentially required compliance with section 2 of the Prevention of Frauds Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-94-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used this rule to reject the argument that omission from testamentary inventory defeated the deceased owner's title and his heirs' rights."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-95-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"This is only statutory background about interlocutory decrees and omits the decisive outside-corpus limitation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-95-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 18(a)(viii) as making the Commissioner include existing access from the nearest public road in the report."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-95-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The actual holding was that the District Court could not adjudicate a roadway outside the partition corpus, not a road outside its jurisdiction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-96-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the notarial lease completed after registration of the partition lis pendens was void under sections 66(1) and 66(2)."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-96-2","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted point is an evidential finding that this tenant's monthly tenancy predated the lease, not a general legal rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-96-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The ratio was that this tenant could rely on a valid prior monthly tenancy not referable to the void lease, which the statement dilutes into a broad proposition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-97-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that compromise in a partition action is possible after title investigation and satisfaction as to the parties' rights."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-97-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"Strict compliance with Civil Procedure Code sections 91 and 408 was part of the court's reason for setting aside the imprecise compromise decree."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-97-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated prior investigation of title as the trial judge's obligation before permitting a partition compromise."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-98-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court allowed ejectment without a prayer for declaration only where title was pleaded in the plaint and tried on accepted issues, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-98-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly held that absence of a declaration-of-title prayer caused no prejudice where title was pleaded and accepted issues raised it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-99-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"This states the litigation contest rather than a rule, and section 3 of the Prescription Ordinance was not construed for that issue-framing statement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-99-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The paper-title possession presumption was a holding, but the cited Prescription Ordinance section 3 relates to adverse possession rather than this presumption."}

