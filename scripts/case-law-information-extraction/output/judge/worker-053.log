+{"rule_id":"draftly-rule-courts-sc-sc_appeal_70_2015.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court did reject collateral challenge on these facts, but the supplied quote only records counsel's reliance on secondary materials and does not support the holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_70_2020.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The section 83 principle is correctly quoted, but the rule omits the court's material qualifications that the inquiry is fact-specific, objective, and borne by the party asserting the trust."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_71_2014.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the plaintiff strangers to the sale could not rely on laesio enormis to rescind the deed, and the quote directly states that rule."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_71_72_2023.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The answer to the leave question is a holding, but the bare quote 'I answer that question in the negative' does not itself support the detailed rule and omits the preserved right to object at scheme stage."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_73_2010.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The right-of-way prescription requirement was applied as the ratio, but the supporting quote is from Thambapillai rather than this judgment's own holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_73_2012-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court allowed declaratory relief because a co-owner may sue a trespasser for declaration of title to an undivided share, and the quote supports that conclusion."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_73_2013.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"Although the court approved the co-owner boundary-action proposition, it was not necessary to the final dismissal, omits that absent co-owners are not bound, and section 115 concerned a different estoppel issue."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_74_2017.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court adopted the principle that a later purchase does not defeat an already accrued prescriptive title, but the supplied quote is counsel's submission relying on Silva v. Zoysa."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_75_2013.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that any prescriptive rights over the road portion were extinguished by the final partition decree and the quote directly supports that holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_75_2017.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court dismissed the late corpus-identification objection as a mixed question not raised below, and the quote states the operative holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_76_2021.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The balance-of-probabilities point was part of the holding, but the supplied quote omits the actual proposition and section 34 of the Buddhist Temporalities Ordinance concerned prescription against temple property, not the proof standard."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_78_2021.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The first-instance rule was applied, but the quote is from Hotel Galaxy and the extracted statement omits the court's express exceptional revision qualification."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_78_2022.pdf-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote reproduces section 3, but the court decided paternity on evidence and only treated legitimation as possible, while the statement drops the statutory proviso."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_7_2004.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The appellate-deference rule was applied to restore the District Court judgment, but the supplied quote is borrowed from Powell and The Sir Robert Peel."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_7_2020.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the fourth defendant had prescribed to Lots D and E as a separate land by possession adverse or independent of the plaintiff's title under section 3."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_7_2021.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The statement is accurately quoted, but the in-rem versus in-personam observation was incidental to the real holdings on title, identification, and the abandoned prescription defence."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_80_2014.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The approbate-and-reprobate principle was applied, but the quote is borrowed authority and the statement is too broad without the election and inconsistent-position limits."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_80_2018.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that section 44 mandatorily required the plaint to plead the ground avoiding prescription where the action was otherwise time-barred, and the quote directly supports it."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_80_2022.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The intention requirement was decisive under section 3, but the supporting quote is from Fernando v. Wijesooriya rather than this court's own holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_81_2013.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court reallocated shares according to the actual deeds, but the supplied quote merely lists the resulting shares and does not support the stated rule by itself."}

