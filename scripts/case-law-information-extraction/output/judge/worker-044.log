"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$rules = Get-Content -Raw scripts/case-law-information-extraction/output/judge/pack-044.json | ConvertFrom-Json
foreach ($r in $rules) {
  $path = Join-Path (Get-Location) $r.text_path
  $text = Get-Content -Raw -Path $path
  $found = $text.Contains($r.supporting_quote)
  "--- $($r.rule_id)"
  "FOUND=$found PATH=$($r.text_path)"
  if ($found) {
    $idx = $text.IndexOf($r.supporting_quote)
    $start = [Math]::Max(0, $idx - 900)
    $len = [Math]::Min(2200, $text.Length - $start)
    ($text.Substring($start, $len) -replace "`r", "" -replace "`n", " ")
  } else {
    $needle = if ($r.supporting_quote.Length -gt 60) { $r.supporting_quote.Substring(0,60) } else { $r.supporting_quote }
    $m = Select-String -Path $path -Pattern ([regex]::Escape($needle)) -Context 6,10 -SimpleMatch:$false | Select-Object -First 1
    if ($m) { ($m.Context.PreContext + $m.Line + $m.Context.PostContext) -join '"' ' }
  }
}" in D:\projects\draftly
