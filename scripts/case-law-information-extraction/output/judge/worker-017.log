"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
from pathlib import Path
pack_path=Path('scripts/case-law-information-extraction/output/judge/pack-017.json')
out_path=Path('scripts/case-law-information-extraction/output/judge/part-017.jsonl')
pack=json.loads(pack_path.read_text(encoding='utf-8'))
lines=out_path.read_text(encoding='utf-8').splitlines()
rows=[json.loads(line) for line in lines]
pack_ids=[r['rule_id'] for r in pack]
out_ids=[r['rule_id'] for r in rows]
print('pack', len(pack_ids), 'rows', len(rows), 'usable', sum(1 for r in rows if r['usable']))
print('missing', sorted(set(pack_ids)-set(out_ids)))
print('extra', sorted(set(out_ids)-set(pack_ids)))
print('duplicate_count', len(out_ids)-len(set(out_ids)))
print('all_keys_ok', all(set(r)=={'rule_id','statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable','reason'} for r in rows))
print('bools_ok', all(isinstance(r[k], bool) for r in rows for k in ['statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable']))
