"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command 'function Show-Case($p, $patterns){
  $text = Get-Content -Raw -LiteralPath $p
  $text = $text -replace '"'\\s+', ' '
  Write-Output \"--- "'$p"
  foreach($pat in $patterns){
    $m = [regex]::Match($text, $pat, [System.Text.RegularExpressions.RegexOptions]::IgnoreCase)
    if($m.Success){
      $start=[Math]::Max(0,$m.Index-500); $len=[Math]::Min(3000,$text.Length-$start)
      Write-Output "--- around: $pat"
      Write-Output $text.Substring($start,$len)
    } else { Write-Output "--- no match: $pat" }
  }
}
