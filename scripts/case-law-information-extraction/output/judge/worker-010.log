new file mode 100644
index 0000000000000000000000000000000000000000..a7daa403eacb7046f0f03c54786a9add38673e3e
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-010.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-12-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court merely distinguished Girantha because it construed the old section 121, so the proposed rule is overbroad and not supported as a general proposition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-22-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The appeal turned on the plaintiff's failure in a declaration of title action to plead and strictly prove the title asserted."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-22-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court set aside relief because it could not grant a declaration on a case not both pleaded and proved."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-22-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated the late new position taken after the defendant had closed his case as impermissible and material to allowing the appeal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-23-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement captures the rent-certainty point but drops the Agrarian Services Act and paddy-field context and the court's fuller fixed-or-readily-ascertainable qualification."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-23-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court rejected the Public Trustee or devalagama-land objection and held that paddy fields remained subject to the paddy/agricultural land regime."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-23-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly decided that one joint ande cultivator could transfer his rights to the other and that succession did not pass to heirs in that situation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-35-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The result is correct for P22, but the statement is tautological and omits that the existing LRC monthly lease required a legal and proper notice of termination."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-35-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used this Roman-Dutch-law distinction between personal lease rights and rights in rem to uphold the petitioner's monthly lease status."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-37-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The estoppel holding depended materially on the proved leases and the defendants' predecessor accepting the plaintiff's lessor title, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-39-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did not say long possession alone can never found ouster, but held that possession must be assessed with income, value, relationship, residence, and the facts of exclusion."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-40-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly limited the partition court's title investigation to the pleadings, admissions, points of contest, and oral and documentary evidence before it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-40-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The failure of the fiscal conveyance claim turned on the court's holding that trust property could not be seized and sold in execution."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-40-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement reflects the result but omits the material fact that only the alleged right, title, and interest of a trustee with no proved vested share had been transmitted."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-6-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The deed proof objection failed because no objection was taken when the documents were read at the close of the plaintiff's case."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-6-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the defendants were not bona fide possessors and could not force unsolicited improvements on the owner and claim compensation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1996-6-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the court's express exception where the owner stands by and allows building without notice of his own claim."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-20-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The partition-title duty was upheld, but the cited Civil Procedure Code section 146 concerned framing issues and was not the provision actually construing that title-investigation duty."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-21-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 60 on the basis that the state lending institution's purchaser was to have a quick and effective recovery-of-possession remedy."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-21-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The case was about ejecting persons outside section 60(3) and (4) by virtue of the certificate of sale, not about a party failing to comply with certificate requirements."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-21-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague and malformed to express any holding, even though the headnote mentions consequential enabling provisions."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-24-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the three stated conditions for fresh evidence under section 773 and refused the application because the documents would not affect the appeal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-24-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did not state a general rule that deeds may be considered at a hearing, but refused these deeds because they did not touch the trial issues."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-28-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used ownership and consequent entitlement to possession as the cause of action in rei vindicatio when rejecting the defective-plaint objection."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-28-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits that the parol evidence must relate to grounds in the proviso to section 92 and does not apply where the deed is only incidentally considered."}

