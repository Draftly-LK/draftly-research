+{"rule_id":"draftly-rule-commonlii-LKCA-1997-21-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague and malformed to express any holding, even though the headnote mentions consequential enabling provisions."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-24-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the three stated conditions for fresh evidence under section 773 and refused the application because the documents would not affect the appeal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-24-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did not state a general rule that deeds may be considered at a hearing, but refused these deeds because they did not touch the trial issues."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-28-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used ownership and consequent entitlement to possession as the cause of action in rei vindicatio when rejecting the defective-plaint objection."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1997-28-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits that the parol evidence must relate to grounds in the proviso to section 92 and does not apply where the deed is only incidentally considered."}

