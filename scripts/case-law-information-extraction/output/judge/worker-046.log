import json
from pathlib import Path
pack=json.loads(Path('scripts/case-law-information-extraction/output/judge/pack-046.json').read_text(encoding='utf-8'))
lines=Path('scripts/case-law-information-extraction/output/judge/part-046.jsonl').read_text(encoding='utf-8').splitlines()
