+{"rule_id":"draftly-rule-courts-sc-sc_appeal_144_2012.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied section 3 prescription principles and held the co-owner prescription claim failed absent cogent evidence rebutting co-owner possession."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_146_2013.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the admitted lease made the case one of privity of contract rather than automatically a rei vindicatio action."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_146_2015.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The proposition was applied by the court, but the supporting quote is an express quotation of Wanigaratne rather than this court's own holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_147_2017.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used this approach to articles of association in affirming the interim order preserving the company's status quo."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_148_2023.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on section 48 finality to reject collateral reliance on undivided rights wiped out by the partition decree."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_149_2014.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the defendants could not tack Jeremius Appuhamy's possession because he was not their predecessor in title."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_151_2011.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote only states the application to the alleged forgery and the statement omits section 103's exception where another law fixes the burden."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_151_2015.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The rule was applied to reject prescription for want of ouster, but the supporting quote is borrowed from Tillekeratne v Bastian."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_152_2025.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly held that prescription fails unless all required elements are proved to its satisfaction."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_153_2010.pdf-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court stated the proposition only while distinguishing it, because it held the plaintiff had not proved he was a co-owner."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_153_2016.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court applied the need for clear adverse user, but the chosen quote only records failure on the facts and omits the stated legal test."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_153_2018.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The proposition was applied, but the quoted support is attributed to Jayawickrama v Amarasuriya rather than this court's own statement."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_154_2018-1.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote is only a deed-specific factual inference and the statement drops the evidential basis needed before treating different names as the same person."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_155_2011.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The rule was used in deciding prescription, but the supporting sentence is part of quoted prior authority on section 3."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_156_2010-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held a valid Finance Act vesting order wiped out tenancy rights and that the Court of Appeal erred by excluding tenants."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_156_2012.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court relied on appellate restraint but the statement omits the material exceptions for factual evaluation and plain error stated immediately after."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_158_2011-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The holding concerned a section 33 Land Acquisition Act deposit and District Court inquiry, while the tagged section 18 concerned reopening before an award."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_158_2013.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The legal rule is correct and applied, but the quote only supports the factual finding that the notary did not know the executants."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_158_2017.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The quote is a question of law framed for appeal, and the court did not construe Partition Law section 16(3) as the rule stated."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_159_2019.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote is borrowed authority and the statement overstates the case by turning lack of documentary evidence in this record into a universal requirement."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_15_2008.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied section 114(d) to presume regular Fiscal execution after the report and affidavit were not rebutted."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_15_2009.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 770 as conferring a wide cautious discretion and directed the High Court to exercise it to add omitted parties."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_15_2012.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the court's additional material requirement that the beneficiary must be clearly indicated."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_15_2015.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The rule was part of the holding, but Civil Procedure Code section 754(1) was only the appeal route and not the provision construed for it."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_161_2016-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used this measurement principle to reject the extent-variation objection to the identity of the partition corpus."}

