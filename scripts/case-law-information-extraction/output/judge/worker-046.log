import json, re
from pathlib import Path
rules=json.loads(Path('scripts/case-law-information-extraction/output/judge/pack-046.json').read_text(encoding='utf-8'))
def norm(s): return re.sub(r'\\s+', ' ', s).strip()
for i,r in enumerate(rules,1):
    text=Path(r['text_path']).read_text(encoding='utf-8', errors='replace')
    nt=norm(text)
    nq=norm(r['supporting_quote'])
    idx=nt.find(nq)
    if idx<0:
        # try first meaningful 80 chars
        token=nq[:80]
        idx=nt.find(token)
    print('\\n'+'='*100)
    print(f\"{i}. {r['rule_id']}\")
    print('STATEMENT:', r['statement'])
    print('STATUTE:', r['statute_section'])
    print('QUOTE_FOUND:', idx>=0)
    if idx>=0:
        start=max(0, idx-900); end=min(len(nt), idx+len(nq)+900)
        print(nt[start:end])
    else:
        print('QUOTE:', r['supporting_quote'])
        print('TEXT_HEAD:', nt[:1200])
        print('TEXT_TAIL:', nt[-1200:])
