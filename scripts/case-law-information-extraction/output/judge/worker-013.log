+{"rule_id":"draftly-rule-commonlii-LKCA-1999-15-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a defendant seeking to partition a larger land must comply with the Partition Law procedure including sections 4, 5, and 6."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-15-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that registering lis pendens alone was insufficient without following the full larger-land procedure in section 19(2)."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-2-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on section 70 and actus curiae to hold that the court had to compel prosecution and parties should not suffer from court-caused delay."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-28-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 16 of the Prevention of Frauds Ordinance as requiring due duplicate attestation of deeds."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-28-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The wording is materially imprecise because the defect was not corrections on a copy as such, but non-matching and unattested corrections across duplicate copies."}
