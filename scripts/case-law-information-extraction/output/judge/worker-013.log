+{"rule_id":"draftly-rule-commonlii-LKCA-1998-6-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court rejected the proposition that this contingent transferee had an interest in the land under section 69, rather than affirming it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-6-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment expressly held that contingent interest was not included in the relevant phrase, making the extracted statement the opposite of the holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-1-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The rule misstates the provision as section 5.408 and omits that the remedy was to the Court of Appeal by revision or restitutio in integrum."}
