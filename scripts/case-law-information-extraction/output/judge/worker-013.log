+{"rule_id":"draftly-rule-commonlii-LKCA-1999-10-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court treated substantiality of the legal question as dependent on the facts of the case when refusing to stay writ."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-10-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the principle that a prospective purchaser in possession is only a licensee or permissive occupier, not a tenant."}
