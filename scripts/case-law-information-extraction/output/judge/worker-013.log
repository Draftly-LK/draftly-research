+{"rule_id":"draftly-rule-commonlii-LKCA-1999-3-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"This is a general policy observation about contempt jurisdiction, not the holding needed to decide liability."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-3-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that contempt is criminal in character and must be proved beyond reasonable doubt before finding guilt."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-3-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment distinguished injunction cases and held that Sri Lankan law does not strictly require proof of wilful mens rea for disobedience of an injunction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-30-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used the Mortgage Act's substantive and procedural role while holding the commercial mortgage action fell within Commercial High Court jurisdiction."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-30-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague and omits the High Court of the Provinces Act, commercial-transaction threshold, and jurisdictional context."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-32-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The condition-precedent point concerned the Conciliation Board Act only as a contrast, while the case turned on the absolute bar in section 56 of the Debt Conciliation Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-32-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The extracted statement generalizes all jurisdictional defects, whereas the court held only that the section 56 Debt Conciliation Ordinance bar was patent on these facts."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-38-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The passage is a fact-specific finding about the defendant priest's conduct, not a legal ratio suitable as a case rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-39-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that once the plaintiff's title was admitted, defendants claiming tenancy bore the burden and had to begin."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-4-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement makes an overbroad res judicata rule and omits the different causes of action, non-participation, and limited effect of the earlier ex parte dismissal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-45-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The title-investigation rule is correct, but the non-empty statute reference points to CPC section 114(2), which was construed for marked documents becoming part of the record."}

