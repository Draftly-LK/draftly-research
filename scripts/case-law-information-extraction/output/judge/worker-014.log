diff --git a/scripts/case-law-information-extraction/output/judge/part-014.jsonl b/scripts/case-law-information-extraction/output/judge/part-014.jsonl
new file mode 100644
index 0000000000000000000000000000000000000000..e6496c9b87694d079c85ecd765f09062cbc07a48
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-014.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-45-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied CPC section 114(2) and the duty to keep marked documents of record as a necessary basis for amending the partition shares."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-50-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material testamentary context that the administrator had a statutory discovery remedy under CPC section 712 for the withheld estate information."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-51-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly distinguished CPC section 14 from section 18 when upholding the addition of the party."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-51-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was that this petitioner should be added to avoid a separate rectification action, not that every party seeking rectification must be joined."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-66-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that prescription is suspended by an action only against a claimant who has been made a party, and the statement preserves that defendant limitation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-70-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that section 55 of the National Savings Bank Act validly passes title by a Bank certificate of sale notwithstanding the Prevention of Frauds Ordinance objection."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-74-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The balance-of-probability statement was made for due execution of a will and is too broad without that probate context."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-74-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court allowed probate because it would give effect to the testator's wishes where the essential elements of execution were satisfied."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-74-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court treated only the specific contradictions about how the will witnesses were gathered as immaterial, not contradictions generally."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-76-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court quashed the cancellation because the State-land lease permit holder had to be given notice and a hearing before cancellation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-76-2","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The natural-justice passage was an alternative observation because the court had already found an express statutory hearing procedure for lease-permit cancellation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-77-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The rule was decided on the limited nature of the leasehold and subtenancy, not by construing Rent Act section 8."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-80-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding was limited to a defaulting partition party's right to object to the final scheme where the Partition Law made no prohibition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-81-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits that the transferees bought only contingent rights pending a partition action and therefore had no interest in the corpus."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-81-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court only held that these pending-action transferees could not be awarded undivided rights, not that courts cannot award undivided rights by judgment and interlocutory decree."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-82-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The definition of a praedial servitude was central to dismissing the claim because the plaintiff was not owner of the dominant tenement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-83-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed Prescription Ordinance section 5 in the usufructuary mortgage context and held time could run only from breach of the relevant condition."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-83-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The subordinate-entry and overt-act rule was a prescriptive-possession holding, but the cited section 5 concerns mortgage actions rather than that rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-83-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The bond-terms limitation on a usufructuary mortgagee was part of the holding, but it was not itself a construction of Prescription Ordinance section 5."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-84-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The obstruction-removal discussion was expressly addressed as an academic point after the appeal was already disposed of for want of reasons."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1999-9-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The rule omits the condition that death occurred after decree while an appeal was pending and wrongly links the point to CPC section 653 sequestration."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2000-1-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The court found surrender or waiver of the ande rights, not a general rule that sale of land may leave those rights unextinguished, and CPC section 147 was not the construed provision."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2000-1-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The attesting-witness conduct supported waiver or surrender on these facts, but the actual statutory issue was under the Agrarian Services Act rather than CPC section 147."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2000-1-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The inference depended materially on the tenant also signing as witness and acting as intermediary, and the cited CPC section 147 was not the provision construed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2000-13-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that legal title remained in Haramanis Soysa as trustee while only beneficial interest vested in the temple, defeating the plaintiff's locus standi."}

