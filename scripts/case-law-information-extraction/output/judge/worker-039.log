import json, re
from pathlib import Path
rules=json.loads(Path('scripts/case-law-information-extraction/output/judge/pack-039.json').read_text(encoding='utf-8'))

def norm(s):
    return re.sub(r'\\s+', ' ', s.replace('\\ufffe',' ')).strip().lower()

for i,r in enumerate(rules,1):
    txt=Path(r['text_path']).read_text(encoding='utf-8', errors='replace')
    nt=norm(txt)
    q=norm(r['supporting_quote'])
    # try anchor: significant nontrivial chunks from quote
    anchors=[]
    words=q.split()
    for size in [12,10,8,6,5]:
        for start in [0, max(0,len(words)//4), max(0,len(words)//2), max(0, len(words)-size)]:
            chunk=' '.join(words[start:start+size])
            if len(chunk)>20 and chunk not in anchors:
                anchors.append(chunk)
    pos=-1; anchor=''
    for a in anchors:
        pos=nt.find(a)
        if pos"'!=-1:
            anchor=a; break
    print(f"'"\\n### {i} {r['rule_id']} pos={pos} anchor={anchor"'!r}")
    print('"'STATEMENT:', r['statement'])
    if pos"'!=-1:
        lo=max(0,pos-900); hi=min(len(nt),pos+1400)
        print(nt[lo:hi])
    else:
        # search statement chunks
        print('"'QUOTE NOT FOUND')
        print(nt[:2500])
