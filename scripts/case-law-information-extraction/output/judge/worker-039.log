"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$env:PYTHONIOENCODING='"'utf-8'; @'
import json
from pathlib import Path
pack=Path('scripts/case-law-information-extraction/output/judge/pack-039.json')
out=Path('scripts/case-law-information-extraction/output/judge/part-039.jsonl')
rules=json.loads(pack.read_text(encoding='utf-8'))
ids=[r['rule_id'] for r in rules]
rows=[]
for line in out.read_text(encoding='utf-8').splitlines():
    rows.append(json.loads(line))
out_ids=[r['rule_id'] for r in rows]
print('pack', len(ids), 'out', len(rows), 'unique_out', len(set(out_ids)))
print('missing', sorted(set(ids)-set(out_ids)))
print('extra', sorted(set(out_ids)-set(ids)))
print('duplicates', [x for x in out_ids if out_ids.count(x)>1])
print('usable', sum(1 for r in rows if r['usable']))
print('all_bool_keys', all(all(isinstance(r[k], bool) for k in ['statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable']) for r in rows))
'@ | python -" in D:\projects\draftly
 succeeded in 3173ms:
pack 25 out 25 unique_out 25
missing []
extra []
duplicates []
usable 11
all_bool_keys True

