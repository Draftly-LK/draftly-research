rows = [
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1990-61-2\",\"statement_correct\":False,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The court decided recoverable pro-rata costs in a partition action on the appraised value, so the statement is overbroad and drops the partition-law context.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-18-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that a donee whose interest devolved under the deed of gift could be substituted under section 404 to continue the action.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-19-1\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The extracted statement and quote are truncated and omit the actual appeal-time computation rule and bond default holding.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-22-1\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The court denied a section 712 citation for post-death rents absent a due-administration need, not a general entitlement to rental income from an estate.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-28-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that a minor's sale of immovable property with guardian assistance but without court sanction carried a presumption of invalidity.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-29-1\",\"statement_correct\":False,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The court construed 'Court' restrictively only in section 48(4)(a)'s partition-law context, not as a general definition for all uses.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-29-2\",\"statement_correct\":False,\"quote_supports\":True,\"is_ratio\":False,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":False,\"reason\":\"This is a general interpretive canon used in the reasoning, not the case's operative holding on the partition survey return date.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-29-3\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"Notice of the returnable date was part of the statutory context, but the usable holding was the computation of the 30 days from receipt in open court.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-48-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court applied section 147 and held that disposal on a preliminary issue requires a pure question of law going to the root of the case.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-48-2\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The extraction changed the holding from no Rent Board application being required to 'without making an admission,' which the quote does not support.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-50-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that a landlord owning no house or not more than one residential premises may maintain a reasonable-requirement ejectment action.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-50-2\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The court held the action was really under section 22(2)(bb), not section 22(2)(b), so the statement reverses the point.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-50-3\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The maxim was applied only to the wrong Rent Act paragraph where the parties were not misled, so the statement is too broad as a standalone rule.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-54-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that a duly appointed Assistant Commissioner could exercise the Commissioner's powers within the appointed area.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-54-2\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that the Prescription Ordinance regulates civil actions and does not apply to Agrarian Services Act proceedings.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-54-3\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The alleged estoppel would have been against the landlord, and the court rejected it because legally fixed rent left no duty to protest.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1991-56-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court held that documents chargeable under section 2 remain exempt if they fall within section 5, including the leave-to-appeal affidavit before it.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1992-15-1\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":False,\"usable\":False,\"reason\":\"The vicarious-liability rule was the holding, but the cited statute section is Civil Procedure Code section 40 rather than the provision construed for this rule.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1992-15-2\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":False,\"usable\":False,\"reason\":\"The prescription-from-death holding is supported, but Civil Procedure Code section 40 was not the statute construed for that rule.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1992-15-3\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":True,\"statute_correct\":True,\"usable\":True,\"reason\":\"The court construed section 40 and held that pleading the facts, claims, and reliefs in the plaint was sufficient compliance.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1992-31-1\",\"statement_correct\":False,\"quote_supports\":False,\"is_ratio\":False,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"Saying the amendment is relevant is not the court's legal holding and the quote supports a much narrower time-bar rule.\"},
  {\"rule_id\":\"draftly-rule-commonlii-LKCA-1992-31-2\",\"statement_correct\":True,\"quote_supports\":True,\"is_ratio\":True,\"qualifications_ok\":False,\"statute_correct\":True,\"usable\":False,\"reason\":\"The statement captures that section 71(2)(aa) operated as a time bar but drops the crucial qualification that it did not affect pre-2 May 1984 pending applications.\"},
