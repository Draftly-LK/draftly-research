@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-2001-99-3","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court used this hypothetical issue-answering point while explaining paper title and prescription, but the extracted statement omits the necessary qualification that a finding of prescription would also have to be recorded."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-17-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The dates are accurately reported, but they are case facts rather than a legal holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-17-2","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held only that this partition action was alive solely for partitioning the corpus after rights were finally disposed of, not a broad rule that courts may keep suits alive for any specific purpose."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-17-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote says this defendant's notice of appeal was rejected and does not support a rule that a notice of appeal must be filed by a defendant-appellant."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-18-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The actual proposition was limited to procedural lapses causing no prejudice or harm, and it was not specifically a construction of section 35(1)."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-18-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that these two claims could be joined with leave under section 35(1) to avoid multiplicity and without prejudice, not that any two claims can be tried together."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-18-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is broader than the holding, which concerned leave under section 35(1) for the two pleaded claims in an immovable-property action."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-2-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The failure to protest and acceptance of rent were the landlord's conduct, not the tenant's, so the statement reverses the relevant party."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-2-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court said it was open to the landlord to terminate the tenancy but she did not do so; the extracted statement incorrectly refers to a tenant and is garbled."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-2-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the landlord's knowing acceptance of the subletting and continued rent acceptance amounted to waiver or condonation barring ejectment for subletting."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-21-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court decided that Nandawathi's rights devolved on her husband and minor children on these facts, not a general rule for every deceased person's mortgage rights."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-21-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly treated the protection under sections 13 and 14 as statutory protection that could not be taken away."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-21-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that prescription was suspended until the minor children's disability was removed by majority or death."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-22-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The true holding was limited to authority to act as a recognized agent under Civil Procedure Code section 25(b), not the general validity of all powers of attorney."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-22-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"Because the plaint caption showed the plaintiff resident within the local limits while suing through an attorney, the court upheld the direction to amend the defective caption."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-26-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The classification of arbitration clauses was background law taken from prior authority, while this court's operative holding concerned the particular lease clause."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-26-2","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The statement describes one category from prior arbitration authority but was not itself the holding of this case."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-26-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court's point depended on the Arbitration Act commencing after the lease and guarantee were executed, a material temporal qualification omitted from the statement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-27-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The holding concerned motor-vehicle registration only, so the unqualified statement about registration generally is unsafe."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-27-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted and applied the rule that motor-vehicle registration deems ownership only for registration-related duties, not real ownership."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-27-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied section 736 to hold that an estate-property contest involving the accounting party belongs in the judicial-settlement proceeding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-30-1","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The rule was confined to belated joinder or misjoinder objections under section 22, not all objections at any late stage of trial."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-30-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on the rule that misjoinder objections must be taken before the hearing and treated the late objection as waived."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-30-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"Although the court used broad language, the safe holding is qualified by the added party's interest and necessity for effectual determination of the issues."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-47-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court decided only that calling the notary and attesting witness was sufficient on these facts, not a general rule that the best possible evidence should be presented."}

