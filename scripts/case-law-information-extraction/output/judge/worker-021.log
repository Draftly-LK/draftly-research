+{"rule_id":"draftly-rule-commonlii-LKCA-2002-60-3","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The maxim was explanatory support for the minor's need to seek court relief, not the case's operative rule, and the cited Land Acquisition Act section was not construed for it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-61-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The source of Enso Nona's marriage certificate was a preliminary factual premise, not the legal holding on succession."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-61-2","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court recited section 3(2), but the operative holding was that the marriage was presumed Diga and Enso Nona therefore did not inherit from her father."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-61-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The Diga presumption was applied, but the statement omits that it applies to a person governed by Kandyan law and is rebuttable by contrary proof."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-62-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court required proof that the plaintiff paid or provided the consideration despite transfer in the defendant's name, not the vague proposition that consideration is independent of the transferee's name."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-62-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court treated intention as a separate section 84 element and said it was irrelevant once the plaintiff failed to prove payment or provision of consideration."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-64-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted the practice allowing even an intervenient to prove title to an unallotted share after interlocutory decree and remitted the application for inquiry."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-64-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court recognised a party's right to prove title to a share left unallotted in the final decree and set aside the refusal to inquire into that claim."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-65-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court's holding was confined to partition proceedings where section 48(4) could not cure non-issue of summons or lack of jurisdiction, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-2002-65-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted language supported relief from an unlawfully obtained partition decree, but the statement is too vague to state the actual procedural holding."}

