+{"rule_id":"draftly-rule-commonlii-LKCA-2002-59-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held heirs of the donee had only a contingent interest, but only in the context of a revocable Kandyan gift whose revocation right had not been renounced."}
