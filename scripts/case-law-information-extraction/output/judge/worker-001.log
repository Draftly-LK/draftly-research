@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-1959-21-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The court accepted the fundamental-breach limitation, but the statement omits the material requirement that the breach be imputable to the contracting party personally and the cited CPC section was not construed for this rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1959-52-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote is the District Judge's reproduced finding and the appellate court held there was no proper proof that the will had been admitted to probate."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1961-11-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is a vague paraphrase and misses the actual holding on an established charitable trust of public character under the exemption provision."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1961-11-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did not hold that income is needed for a trust to be validly established, but that exempt income must be income of an established charitable trust."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1961-11-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quoted passage supports the holding that a charitable trust must benefit the public or a section of the public."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1963-3-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote reproduces trial-level findings and the appellate ratio was instead that an administrator cannot be made to account for property not received qua administrator."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1963-3-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"This is a fact-specific item from the lower court's accounting order, which the appellate court set aside rather than adopted as a legal rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1965-67-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court made a narrow evidentiary comparison on the facts, including an attesting witness, not a general rule that reliability is determined by original or certified documents."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1965-67-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quote directly supports the holding that an unpleaded mixed question of fact and law cannot be raised for the first time in appeal."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1969-46-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The quote supports a fact-specific finding that the copies differed, but that finding is not itself the legal ratio of the case."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1969-46-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that signatures taken on blank notarial forms later filled meant there was no due execution of the deed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1969-46-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quoted passage supports the holding that the court could act on an illegality in a notarial document disclosed by the evidence."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1971-72-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quote directly states the probate rule that the party propounding the will bears the onus of proving it."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1971-72-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The burden is on the propounder of the will, not on the testator, so the statement reverses the legal actor."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1971-72-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement captures the general rule but omits the court's material qualification that suspicious circumstances require the propounder to remove the suspicion."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1973-38-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quote supports the holding that possession under an acknowledged limited right will not become adverse until that limited character is shed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-1-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quote directly supports the jurisdictional holding after a section 284 reference to the District Court."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-1-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted holding concerns the Public Trustee's lack of jurisdiction pending the District Court reference, not a party's opportunity to be heard."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-1-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The quote directly supports the holding that section 295 cannot be used while a court reference is pending."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-12-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The supporting passage is largely a quotation of another case and the majority disposed of the appeal on mens rea while reserving the parate-execution validity issue."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-12-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement comes from a quoted Oudh decision that the present court distinguished, not from this court's own holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-12-3","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court did use consent as a distinguishing observation, but it was not the majority ratio because the appeal turned on bona fide claim of right and absence of dishonest intent."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-15-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that an assignment of an existing mortgage was valid precisely because it was not a voluntary alienation of an interest in the land, so the statement is misleading."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1974-2-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The headnote and final order support the majority holding that section 24 does not bar injunctions for ministerial acts alleged to be without jurisdiction, ultra vires, or in bad faith."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1975-11-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The majority holding states that once importation is proved section 152 shifts the burden of proving lawful importation to the claimant."}

