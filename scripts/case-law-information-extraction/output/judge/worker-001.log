lines=Path('scripts/case-law-information-extraction/output/judge/part-001.jsonl').read_text(encoding='utf-8').splitlines()
objs=[json.loads(line) for line in lines]
pack_ids=[r['rule_id'] for r in pack]
out_ids=[o['rule_id'] for o in objs]
print('pack', len(pack_ids), 'out', len(out_ids), 'unique_out', len(set(out_ids)))
print('missing', sorted(set(pack_ids)-set(out_ids)))
print('extra', sorted(set(out_ids)-set(pack_ids)))
print('dupes', sorted([x for x in set(out_ids) if out_ids.count(x)>1]))
print('usable', sum(1 for o in objs if o['usable']))
required=['rule_id','statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable','reason']
print('schema_ok', all(list(o.keys())==required for o in objs))
print('bools_ok', all(all(isinstance(o[k], bool) for k in required[1:7]) for o in objs))
