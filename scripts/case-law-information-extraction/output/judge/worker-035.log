+{"rule_id":"draftly-rule-commonlii-LKSC-1996-15-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that section 175(1) permits an unlisted witness only where special circumstances make it advisable in the interests of justice."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-16-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 523 and held that the pleadings disclosed a conflict of claims requiring the executor's claim to prevail over the widow's."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-34-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The substitution rule is supported, but the cited statute identifier is Rent Act section 36 rather than Finance Act section 71."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-34-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The court expressly left open whether a testate heir had priority over specified heirs, and the statute identifier is also wrong."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-43-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The passage is a fact finding that separation, division, and adverse possession were proved, not a rule that those matters are evidence under section 10."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-7-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is only a background statutory premise and omits the operative jurisdictional point about inquiries into post-enrolment professional conduct."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-7-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied section 42(2) and held that an Attorney-at-Law guilty of deceit or malpractice may be suspended or removed."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-7-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The central holding was that the Supreme Court retained jurisdiction to inquire into each rule concerning conduct qua Attorney-at-Law despite prior removal."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-8-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The parenthetical records that Wadugodapitiya J. dissented, not that the court's decision was based on the dissent."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-8-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The proposition is part of the holding, but it omits material qualifications about severance, rebuttal of registration, and binna readmission."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1996-8-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement drops the material words that the marriage continues as binna or diga only until dissolved and as the case may be."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1997-51-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The misconduct finding is real, but the extracted statement is too general and omits the specific retainer, fee, conflict, and failure-to-return-money circumstances."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1997-51-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement says no holding is available although the judgment and headnote contain actual professional-misconduct holdings."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-10-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a state-authorised deed of dedication alone did not make the temple Sanghika property without dedication according to Vinaya."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-17-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court dealt with a particular non-party with no apparent right in execution proceedings, not a general rule that any non-party has no right to possession."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-18-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The burden rule is supported, but it omits the material condition that the plaintiff's legal title was admitted or proved in a vindicatory claim."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-20-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that section 25(b) does not require a recognised agent's general power of attorney to be filed when the plaint is filed."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-21-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is an incomplete fragment and therefore cannot state the court's rule."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-21-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the first proviso to section 175(1) gives the trial judge discretion to allow an unlisted witness where special circumstances justify it."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-21-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court upheld refusal only because no special circumstances or explanation were shown, which the extracted statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-3-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The statement is a vague fragment and the cited Civil Procedure Code section was only analogical, not the provision construed for the admiralty holding."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-3-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The counterclaim rule is the holding, but the cited statute identifier points to CPC section 654 rather than the Admiralty Jurisdiction Act provision construed."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-50-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The revision point is supported, but the statement omits the exceptional facts of collusion, refusal of intervention, and total want of title investigation."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-6-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits that the order was a refusal under Partition Law section 48(4)(a)(iv) and was treated as an order requiring leave under section 754(2)."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-6-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague to express any rule decided by the court."}

