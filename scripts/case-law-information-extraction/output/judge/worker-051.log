+{"rule_id":"draftly-rule-courts-sc-sc_appeal_4_2012.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The quoted laesio enormis formulation is textbook background, while the court held the doctrine unavailable because the plaintiff knew the true value and fraud was not properly pleaded."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_4_2015_1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that mandatory Debt Recovery Act summary procedure could not be converted into regular procedure by consent or by the court."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_4_2016-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the plaintiff's unproved notarial deed could not establish paper title without section 68 proof or a recorded admission under section 70."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_50a_2013.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The rule reverses the section 358 logic, because the creditor lost secured status when it failed to comply with the liquidator's notice and was deemed to have surrendered the charge."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_51_2022.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court interpreted the deed as conveying only house H5, the land covered by it, and the road reservation, with the adjacent lots described only for identification."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_52_2018.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted sentence is a factual observation within a broader corpus-identification analysis and omits the actual legal qualification that the totality of evidence must be considered."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_53_2017.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The extracted rule omits the decisive post-Act No. 19 of 2011 balance-principal holding and wrongly maps Recovery of Loans by Banks section 5A to SRC001."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_53_2019.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied section 3 of the Prescription Ordinance and required a defined starting point and credible evidence before accepting prescriptive title."}

