+{"rule_id":"draftly-rule-courts-sc-sc_appeal_172_2014_am1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court directly held that acceptance, though not formal or technical as in Roman-Dutch law, is an element for completion of a valid Kandyan-law gift."}
