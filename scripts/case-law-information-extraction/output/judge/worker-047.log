foreach ($r in $pack) {
  $path = Join-Path (Get-Location) $r.text_path
  $text = Get-Content -Raw -LiteralPath $path
  $quote = [string]$r.supporting_quote
  $idx = $text.IndexOf($quote)
  if ($idx -lt 0) { $needle = $quote.Substring(0, [Math]::Min(80,$quote.Length)); $idx = $text.IndexOf($needle) }
  Write-Output "--- $($r.rule_id)"
  Write-Output "STATUTE: $($r.statute_section)"
  Write-Output "STATEMENT: $($r.statement)"
  if ($idx -ge 0) {
    $start = [Math]::Max(0, $idx - 900)
    $len = [Math]::Min(2200, $text.Length - $start)
    ($text.Substring($start, $len) -replace "`r?`n", " ")
  } else { Write-Output "QUOTE NOT FOUND" }
}
