+{"rule_id":"draftly-rule-courts-sc-sc_appeal_172_2017.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement drops the critical Rent Act and co-owner-consent qualifications and is contrary to the Court's recognition that a valid protected tenancy can survive partition or sale."}
