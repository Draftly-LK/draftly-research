+{"rule_id":"draftly-rule-courts-sc-sc_appeal_174_2015.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court relied on section 5 of the Partition Law to hold that the plaintiff had manifestly disregarded the statutory duty to bring known claimants before Court."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_175_2025.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court construed section 68 of the Evidence Ordinance and held that a notary may prove execution as an attesting witness if he knew the executant and can identify the signature."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_176_2016.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court construed section 328 of the Civil Procedure Code and held that possession need not mean physical occupation at the time of execution."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_17_2015.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The Court applied the repudiation-of-tenancy principle under section 22, but the selected quote is reproduced from Ranasinghe v. Premadharma rather than this Court's own holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_17_2016.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The Court applied section 404 to allow substitution after devolution of interest, but the selected quote is from Pless Pol rather than this Court's own reasoning."}
+{"rule_id":"draftly-rule-courts-sc-sc_appeal_180_2011.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that failure to cite section 83 in the District Court judgment was not fatal absent prejudice, and the quote supports that jurisdiction-validating principle."}

