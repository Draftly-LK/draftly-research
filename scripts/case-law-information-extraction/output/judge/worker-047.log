+{"rule_id":"draftly-rule-courts-sc-sc_appeal_169_2013.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Court held that section 187 requires disclosed reasoning, not numbered answers, where the judgment substantively resolves the points of contest."}
