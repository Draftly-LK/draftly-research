+{"rule_id":"draftly-rule-commonlii-LKCA-1975-17-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is an overbroad formulation drawn from a quoted earlier case rather than this court's own precise Land Acquisition Ordinance holding."}
