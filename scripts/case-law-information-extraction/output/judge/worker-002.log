+{"rule_id":"draftly-rule-commonlii-LKCA-1975-6-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court decided the quantum point on the basis that alimony pendente lite ended on the husband's death."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-11-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment directly addressed the consequence of default under section 63(3), so the statement saying it was not addressed is wrong."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-11-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The actual holding was narrowly about striking off a claim for default in prepayment of costs, while the statement says only vague unspecified orders."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-18-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly held that the State may take advantage of the Prescription Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-18-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that P19 was not an acknowledgment of the plaintiff's claim and therefore did not defeat prescription."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-21-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that uncertainty of title to the trust property was the condition permitting a section 112(1) vesting order."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-21-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote concerns uncertainty of title and a vesting order, not any rule that a trust can be created under the Trusts Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-21-3","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court decided the custom for this particular Badrakali Kovil and preserved other male descendants' poosari rights, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1976-22-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The judgment held the opposite: the lapse principle had no application on the facts because the property was given on trust."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-11-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that an ex facie duly executed Indian power of attorney attracted the section 85 presumption."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-15-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court applied the rule that cancellation of a lease requires grave misuse and found the proved damage insufficient."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-2-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The cross-appeal was allowed because the parties' rights had to be determined as at the date the action was instituted."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-2-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement confuses the Buddhist Temporalities Ordinance with the prescription issue and does not state the court's actual holding."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-4-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court applied Evidence Ordinance section 95, but only because the assessment numbers and evidence gave a definite description of the land intended to pass."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-6-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The deed failed because the maker had never acted as Viharadhipathi and acted during the true Viharadhipathi's lifetime, not because every Viharadhipathi lacks appointment power."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-6-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that D2 by itself did not prove surrender or abandonment and could operate only as an appointment of a successor."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1977-9-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the combined section 247 and Paulian action could not be instituted without the required Conciliation Board certificate."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1978-4-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court's inherent-power holding was limited to correcting its own procedural notice mistake by pronouncing the same judgment afresh."}

