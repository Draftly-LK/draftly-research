+{"rule_id":"draftly-rule-commonlii-LKCA-1988-51-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that prescription had to be reconsidered in the plaintiff's new character as transferee from Jefferjee."}
