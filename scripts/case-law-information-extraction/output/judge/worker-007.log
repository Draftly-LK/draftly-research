+{"rule_id":"draftly-rule-commonlii-LKCA-1989-41-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is too vague to reflect the holding about the limited prohibitory order available under section 69(2)."}
