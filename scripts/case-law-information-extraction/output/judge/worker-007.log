+{"rule_id":"draftly-rule-commonlii-LKCA-1988-9-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The prior cases were maintenance actions and the present action was a status claim, so the statement misstates the res judicata reasoning."}
