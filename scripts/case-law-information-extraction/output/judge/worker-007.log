+{"rule_id":"draftly-rule-commonlii-LKCA-1990-36-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"A declaration was appropriate in this contractual-right context, but the statement is overbroad without that qualification and the mandamus contrast."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1990-55-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that Rent Act protected tenancies survive a partition decree or certificate of sale even if not reserved in the partition decree."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1990-55-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is malformed and fails to state the actual section 52(2)(b) and Rent Act protection rule for lawful sub-tenants."}
