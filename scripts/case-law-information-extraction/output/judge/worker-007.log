+{"rule_id":"draftly-rule-commonlii-LKCA-1989-45-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the lis pendens was correctly registered in the folios of the deeds for the land described in the plaint."}
