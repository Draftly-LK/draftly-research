'2000/11.md':['section 7','section 5','upon account stated','section 6','date of default'],
'2001/18.md':['Clause 29','Clause 13','Guideline No. 136','level field','Article 12'],
'2001/30.md':['liable to revocation','not prescribed','null and void','marital home','litis contestatio'],
'2001/31.md':['vested in his heirs','oral evidence','notarially executed','trust'],
}
base=Path('data/processed/docs/case-law/commonlii/LKSC')
for rel, ts in terms.items():
    p=base/rel
    text=p.read_text(encoding='utf-8', errors='replace').replace('\\r','').replace('\\n',' ')
    print('\\n###', rel, 'chars', len(text))
    for term in ts:
        idx=text.lower().find(term.lower())
        if idx==-1:
            print('TERM NOT FOUND', term)
            continue
        start=max(0, idx-700); end=min(len(text), idx+1200)
        print('\\n--', term, '--')
        print(text[start:end])
