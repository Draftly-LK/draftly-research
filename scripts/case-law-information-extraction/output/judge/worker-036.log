--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-036.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-61-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The judgment construes Rent Act section 22 and holds that single-house ownership is not a condition precedent to this ejectment action."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-61-2","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court described the protection for a tenant against a purchaser-over-the-head but held it did not apply because the plaintiff was already the landlord before purchase."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-65-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on the omission from the Praveni list, absent adequate explanation, to infer Maruwena tenure and uphold the temple trustee's superior title."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-66-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The decisive holding was that the evidence did not establish collusion within section 7(2) of the Registration of Documents Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1998-67-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement overgeneralises the exceptio rei venditae et traditae holding and omits the prior transfer and later reacquisition facts that made title pass to Swarna Jayanthi."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-11-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that recalling probate could not rest on an unsupported finding that the appellant did not understand Sinhala."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-39-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that time generally runs on each overdraft when made and that the dormant overdraft claim against the customer was prescribed."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-41-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The section 68 point was framed as an alternative after the court said due execution had not arisen at trial, and the statement omits the notary-dead and witness context."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-50-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The jurisdiction holding was confined to the borrower's challenge to the Bank's mortgage-sale purchase and is too broad without that context."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-50-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court directly construed section 50(1) to bar post-mortgage claimants through the borrower, while preserving the borrower's own challenge."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-50-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material qualification that the certificate does not prevent review of whether the Bank acted lawfully, in good faith, and commercially reasonably."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-52-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted purchaser-standing proposition was noted as settled and undisputed, while the appeal turned on the absence of proof that the management document was a sham subletting."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-52-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court's operative factual holding was that no evidence showed document IV 10 was a sham rather than the management agreement it purported to be."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-53-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The Supreme Court ordered a fresh trial because the District Judge's misunderstanding of the primary land-use facts vitiated the judgment."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-54-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement states the section 2 rule but drops the central fraud exception under which the court considered the non-notarial document."}
+{"rule_id":"draftly-rule-commonlii-LKSC-1999-8-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that abandonment of a lawful Viharadhipathi's right is strongly presumed against and must be clearly proved."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2000-11-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court's holding was that this was not a section 7 money-lent or account-stated claim but a mortgage-bond claim governed by section 5."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2000-4-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court upheld adding the finance company as a defendant to avoid multiplicity and fully adjudicate the alleged fraudulent title transaction."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-18-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that failure to submit the local-agent registration required by Clause 29 before bidding made the tender board's acceptance unlawful."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-18-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that Clause 13 required rejection of a bid lacking acceptable bid security for the required period."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-18-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that failure to notify all tenderers and invite representations breached Guideline 136 and violated equal-opportunity transparency."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-30-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court affirmed revocation of deed P3 because the donee wife's conduct amounted to ingratitude on the facts found."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-30-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement reverses the holding, because the court held the relief was not prescribed despite the lapse of more than ten years."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-30-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that once deed P3 was revoked, the plaintiff's later gift of the same property to her nephews was null and void."}
+{"rule_id":"draftly-rule-commonlii-LKSC-2001-31-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that an intestate's rights vested immediately in the heirs and that those vested rights could be validly gifted by notarial deed."}

