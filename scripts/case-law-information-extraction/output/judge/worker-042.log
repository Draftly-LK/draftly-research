@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-courts-coa-ca_dc_badulla_385_1996.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court merely found the appellants' documents failed to prove their alleged 50-year possession, not that prescription requires possession for more than 50 years."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_balapitiya_830_98.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The burden proposition was applied as part of the decision, but the supplied quote is a quotation from Rasiah v Somapala rather than this court's own supporting language."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_batticaloa_968_96_f.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement reverses the adopted rule, because the court said abandonment of the principal servitude carries the accessory with it, not the other way around."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_colombo_438_1999.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The privity rule was adopted as necessary to decide the landlord-tenant appeal, but the quote is reproduced Supreme Court authority and SRC029-s58 was not the provision construed."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_colombo_780_98.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court did apply Section 3 of the Prescription Ordinance, but the supplied quote only lists authorities and transitions to the facts rather than stating the rule."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_galle_123_99.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court stated and applied the Section 3 burden-and-starting-point requirement to reject the defendants' prescriptive claim."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_gampaha_777_1999.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court formulated this joinder rule for pleaded rights of way and used it to reject the appellant's non-joinder argument."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_gampaha_84_98.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The decision turned on the judge's Partition Law duties after a doubtful survey return, but the supplied quote is factual and the statement drops the material survey-identity conditions."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_homagama_1113_98.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports the factual holding on adverse possession for over ten years, but the statement omits material Section 3 conditions such as undisturbed and uninterrupted possession."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_kalutara_534_95.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed and applied Civil Procedure Code section 289 to hold that the certificate of sale alone did not pass title without a Fiscal's conveyance."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_kandy_1102_98.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on Partition Law section 26(4) and the common-ownership condition when affirming partition of the lands."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_kegalle_684_98.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed Trusts Ordinance section 83 and applied it to hold that the deed operated as security rather than an outright transfer of beneficial interest."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_kuliyapitiya_293_00.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The temple-property prescription point was decisive, but the quote only says the plea failed, the proviso is omitted, and SRC071-s34 is the wrong statute."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_matale_827_2000.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed Notaries Ordinance section 4A and held that a notary may attest within the same judicial zone though residing in a different district."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_matara_1816_2006.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is misworded and overbroad, and the supplied quote is the District Judge's reproduced reasoning rather than the appellate court's own holding."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_mt.lavinia_549_98.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court adopted the gross-ingratitude rule and applied it to the donee's assault on the donor to uphold revocation of the gift."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_negombo_41_2000.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports the result, but the statement is too broad because the court tied ejectment to an expired notarial lease, Rent Act protection, authorized rent, and non-payment or non-deposit."}
+{"rule_id":"draftly-rule-courts-coa-ca_dc_rathnapura_729_00.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted presumption was used in the Section 3 analysis, but the statement drops the companion qualification that possession begun under another title continues as such until a distinct change is proved."}
+{"rule_id":"draftly-rule-courts-coa-ca_la_15_03.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The access-way rule was necessary to the partition scheme decision, but the judgment did not construe Civil Procedure Code section 754(2)."}
+{"rule_id":"draftly-rule-courts-coa-ca_la_420_2003.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that section 91A can enlarge time, but the statement omits the statutory condition of sufficient cause and the probate-objection context."}
+{"rule_id":"draftly-rule-courts-coa-ca_phc_263_2006.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court used this Section 431 possession-discretion principle to affirm release of the seized vehicle to the bona fide purchaser in possession."}
+{"rule_id":"draftly-rule-courts-coa-ca_writ_613_2007.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The court adopted the encumbrance effect of the registered acquisition notice, but the provision was Finance Act section 71(2A), not SRC012-s71(1)."}
+{"rule_id":"draftly-rule-courts-coa-ca_writ_70_2015.pdf-1","statement_correct":false,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote records a fact-specific reason for quashing the quit notice, but the statement overgeneralizes it and omits the section 21A transfer, land-identity, lease-term, and ultra vires context."}
+{"rule_id":"draftly-rule-courts-coa-cala_dc_mt.lavinia_41_2007.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The supplied proposition comes from counsel and a textbook about Fiscal's sales, while this appeal concerned a bank parate sale and intervention in a pending partition case."}
+{"rule_id":"draftly-rule-courts-coa-DCF-0541-2000-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote supports the prescriptive-title outcome, but the statement omits the co-owner context, adverse possession against other co-owners, physical demarcation, and inferred ouster."}

