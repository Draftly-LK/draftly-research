diff --git a/scripts/case-law-information-extraction/output/judge/part-000.jsonl b/scripts/case-law-information-extraction/output/judge/part-000.jsonl
new file mode 100644
index 0000000000000000000000000000000000000000..ef7c8617808f0e58dabafcf6430ebbbb1e26184e
--- /dev/null
+++ b/scripts/case-law-information-extraction/output/judge/part-000.jsonl
@@ -0,0 +1,25 @@
+{"rule_id":"draftly-rule-commonlii-LKCA-1903-90-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The appellate court upheld voidness of the post-institution conveyance, but the quoted passage is the lower court's reproduced judgment and the statement omits that the rule concerns voluntary alienation of the partitioned interest."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1905-33-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that Karunaratne's sale of shares during the pending partition proceedings was absolutely void even though he was not a party to the partition action."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1905-33-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court said the District Judge could make Karunaratne a party and reapportion shares after inquiry, not that a party may itself reapportion purchased interests."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1907-2-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted passage is the District Judge's reproduced reasoning and the appellate ratio was the substantive bar in section 339, not a general rule that every sale under an illegal writ is void."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1910-51-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":false,"usable":false,"reason":"The Crown grant's prohibition on alienation was held limited to voluntary alienation, but SRC058-s7 was not the provision construed for that rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1910-51-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The private sale conferred no title only because the Fiscal's purchaser took subject to the Crown grant's inalienability condition, and SRC058-s7 was not the provision construed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1911-46-1","statement_correct":true,"quote_supports":false,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The appellate court accepted the finding that the missing will was presumed destroyed, but the quote is the lower court's reproduced finding and the ratio concerned statutory revocation of the codicil."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1912-74-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court rejected the double stamp duty objection, but the statement is too broad without the section 71 context and the prior probate administration setting."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1912-74-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The appellant could sue for her share without letters in this procedural setting, but the statement drops the material facts that probate had issued, her status had been declared, and the estate had been administered."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1929-50-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement and quote state the rule from Andrishamy v Silva, while this case applied a similar principle to a creditor who had notice and acquiesced in the court-controlled sale."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1936-47-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The court mentioned that construction rule while distinguishing another case, but the holding here was that the clear operative part prevailed over any recital-based trust."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1937-88-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The passage recites a binding ruling from Sangarapillai, while this case decided that heirs of a wife who died pending the hypothecary action had to be made parties to bind them."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1945-21-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quote is from an Indian Order 22 Rule 10 case, while this court's ratio concerned section 404 discretion and ultimately refused intervention on the facts."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1946-67-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court protected the bona fide purchaser from a decree-holder purchaser after later reversal of the decree, but the quote is from a Madras case and the statement omits the execution-sale setting."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-18-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted proposition about joint affirmative injury comes from earlier tort authority, whereas this court decided that two suretyship documents formed one composite obligation and one cause of action."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-18-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement is not a legal rule or holding of the case and the quote is only a passage discussing earlier authorities."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-18-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The withdrawal-and-dismissal discussion is from Croos v Goonewardene Hamine and was used by analogy, not decided as this case's rule."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-77-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court made a fact-specific finding that there was no evidence this defendant had been a cultivator before the mortgage, not a general rule about inference from absence of evidence."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-77-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that any tenant-cultivator rights were extinguished when the usufructuary mortgage rights were taken, through surrender or through surrender and merger."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1950-77-3","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court relied on the stated principle that surrender occurs when the parties do an act inconsistent with the continuing landlord-tenant relation."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1951-16-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a Viharadhipathi title action concerning the temple and temporalities can continue by or against the successor-in-title under section 404."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1951-16-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that the appeal abated because no substitution had in fact been made, not that substitution could not be made for a deceased defendant."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1958-2-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted proposition is part of the lower court's position that was reversed, and the appellate court held the Land Commissioner lacked authority because the paraveni nilakaraya was not an owner under the Ordinance."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1959-21-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The first defendant was held liable, but the statement is too generic for the delivery-order facts and SRC030-s772 was merely a procedural cross-appeal provision, not the rule construed."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1959-21-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The statement contradicts the judgment because the plaintiff recovered against the first defendant and failed only against the carrier protected by the exemption clause, while SRC030-s772 was not the construed rule."}

