import json
from pathlib import Path
pack_path=Path('scripts/case-law-information-extraction/output/judge/pack-012.json')
out_path=Path('scripts/case-law-information-extraction/output/judge/part-012.jsonl')
pack=json.loads(pack_path.read_text(encoding='utf-8'))
lines=out_path.read_text(encoding='utf-8').splitlines()
objs=[json.loads(line) for line in lines]
pack_ids=[r['rule_id'] for r in pack]
out_ids=[o['rule_id'] for o in objs]
print('pack', len(pack_ids), 'lines', len(lines), 'objs', len(objs))
print('missing', sorted(set(pack_ids)-set(out_ids)))
print('extra', sorted(set(out_ids)-set(pack_ids)))
print('duplicates', [x for x in out_ids if out_ids.count(x)>1])
print('order_match', pack_ids==out_ids)
print('usable', sum(1 for o in objs if o['usable']))
print('bad_bool_keys', [(o.get('rule_id'), k, type(o.get(k)).__name__) for o in objs for k in ['statement_correct','quote_supports','is_ratio','qualifications_ok','statute_correct','usable'] if type(o.get(k)) is not bool])
