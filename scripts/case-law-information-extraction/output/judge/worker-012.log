+{"rule_id":"draftly-rule-commonlii-LKCA-1998-21-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a co-owner could not build on paddy land without consent where the building would materially alter the land's character."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-22-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The rule is stated too generally because the deed was void for transfer of Land Development Ordinance land without the required authority."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-22-2","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court rejected prescription only for land alienated under a permit because section 161 barred prescriptive title, not for long possession generally."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-22-3","statement_correct":false,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The estoppel holding depended on the deed being ab initio void and the plaintiff lacking any legal power to alienate, which the statement recasts too broadly."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-30-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a consent decree settling matters outside the action's subject matter was beyond sections 188 and 408 of the CPC."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-31-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The judge's definition of nuisance was central to allowing the Rent Act appeal and is supported by the quoted passage."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-31-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The inference point was confined to nuisance evidence and admitted facts where positive evidence from adjoining occupiers was unnecessary."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-31-3","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"This is a case-specific criticism of the District Judge's evaluation rather than a distinct legal ratio fit for reuse."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-32-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that grants of probate or administration are preliminary and do not bar later heirship claims before judicial settlement."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-34-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the CPC does not prohibit a party from moving the court by motion at any stage for appropriate relief."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-35-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The statement omits the material requirement that the reconventional claim must be capable of set-off or adjustment with the plaintiff's claim."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-35-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that absence of a replication did not bar issues arising from a claim in reconvention."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-47-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court construed section 22(1)(bb) as addressing the limited class of tenants in occupation before 1 March 1972."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-47-2","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the tenant's length of occupation mattered under section 22(1)(bb), not a later change of landlord by attornment."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-47-3","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The ratio was that the tenant's first occupation date was relevant, not the vague proposition that the Act's commencement date controls unspecified provisions."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-5-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The judgment concerned a prima facie injunction over road servitudes, while the claimed rule misstates the holding and cites CPC section 18, which was only discussed for joinder."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-50-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The donor's revocation right was upheld subject to the statutory exception for express renunciation, which the statement omits."}
+{"rule_id":"draftly-rule-commonlii-LKCA-1998-50-2","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court did not hold that every Kandyan deed of gift must renounce revocation, only that renunciation must be express if relied on."}
