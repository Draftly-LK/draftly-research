pack=json.loads(Path('scripts/case-law-information-extraction/output/judge/pack-056.json').read_text(encoding='utf-8'))
terms=['For all','I hold','I am of the view','Appeal','Application','Rule','violated','prescribed','excussion','renounced','duty','warranty','Polluter','Clause 218','section 31','malpractice','suspended']
