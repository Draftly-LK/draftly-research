+{"rule_id":"draftly-rule-courts-sc-sc_chc_appeal_5_2007.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that the guarantors had renounced excussion and were liable as principal debtors, so the quote supports a dispositive suretyship rule with no statute claimed."}
+{"rule_id":"draftly-rule-courts-sc-sc_chc_appeal_62_2012.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The no-advice/no-warranty holding was necessary to dismiss the counterclaim, but the supporting quote is a quotation from another case rather than this court's own holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_chc_appeal_64_2013.pdf-1","statement_correct":false,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted passage states the ordinary benefit of excussion, but the court's actual holding was that this benefit had been waived by the guarantors."}
+{"rule_id":"draftly-rule-courts-sc-sc_chc_appeal_7_2012.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The court held that section 7 and a three-year period applied, while the quote is from Silva v Silva and the statement confusingly suggests a one-year goods-sold rule."}
+{"rule_id":"draftly-rule-courts-sc-sc_fr_13_2020.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The court accepted the instalment-purchase document as residence proof in the special circumstances under a school circular, not as a rule construing Prevention of Frauds Ordinance section 4."}
+{"rule_id":"draftly-rule-courts-sc-sc_fr_141_2015.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court expressly applied the Polluter Pays principle to order the 8th respondent to fund compensation and rehabilitation, with no statute section claimed."}
+{"rule_id":"draftly-rule-courts-sc-sc_fr_171_2017.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held that a public officer must receive sufficient grounds for a transfer to exercise the constitutional appeal right, and the quote directly supports that holding."}
+{"rule_id":"draftly-rule-courts-sc-sc_fr_298_2021.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":true,"reason":"The court held the exigencies-of-service transfer arbitrary because Clause 218 criteria and the real reasons were not properly disclosed to the officer."}
+{"rule_id":"draftly-rule-courts-sc-sc_fr_311_2016-1.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The transfer reasoning is materially tied to PSC Rules 218 and 221 and Article 12, while the cited Evidence Ordinance section 114(f) was only an evidential inference point."}
+{"rule_id":"draftly-rule-courts-sc-sc_misc_2_2012-1.pdf-1","statement_correct":false,"quote_supports":false,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The extracted rule overstates a borrowed Doody formulation as an absolute rule, whereas this court's holding was the narrower fair-hearing breach in the gem-licence process."}
+{"rule_id":"draftly-rule-courts-sc-sc_rule_1_2010.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":true,"statute_correct":true,"usable":false,"reason":"The malpractice standard was applied to remove the attorney, but the supporting quote is a passage from In Re Arthenayake rather than this court's own formulation."}
+{"rule_id":"draftly-rule-courts-sc-sc_rule_3_2011.pdf-1","statement_correct":true,"quote_supports":false,"is_ratio":true,"qualifications_ok":false,"statute_correct":false,"usable":false,"reason":"The eight-year suspension was the order, but the quote does not support that rule and section 19(2) only governed notarial disqualification after attorney suspension."}
+{"rule_id":"draftly-rule-courts-sc-sc_rule_8_2022.pdf-1","statement_correct":true,"quote_supports":true,"is_ratio":false,"qualifications_ok":false,"statute_correct":true,"usable":false,"reason":"The quoted expectation of high standards was stated by the court, but the holding discharged the rule after finding no deceit or malpractice in the particular circumstances."}

